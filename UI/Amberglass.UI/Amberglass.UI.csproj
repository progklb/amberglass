<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Amberglass.UI</RootNamespace>
    <AssemblyName>Amberglass</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.18" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Amberglass.Core\Amberglass.Core.csproj" />
    <ProjectReference Include="..\..\Database\Amberglass.Database\Amberglass.Database.csproj" />
    <ProjectReference Include="..\..\Metadata\Amberglass.Metadata\Amberglass.Metadata.csproj" />
    <ProjectReference Include="..\..\Preview\Amberglass.Preview\Amberglass.Preview.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Path abbreviation for the recent-workspaces menu is internal but worth testing directly. -->
    <InternalsVisibleTo Include="Amberglass.Tests" />
  </ItemGroup>

  <!--
    Bundled rather than relied on from the system: the faces the handwritten option offers are not
    present on Linux or Windows, and a font setting that silently does nothing on two platforms is
    worse than not having one. Both are SIL Open Font Licence; the licence text ships beside them,
    which is all the OFL asks.
  -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <None Include="Assets/Fonts/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
