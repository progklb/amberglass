<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Amberglass.UI.ViewModels"
        xmlns:core="using:Amberglass.Core.Models"
        mc:Ignorable="d"
        x:Class="Amberglass.UI.Views.SyncWindow"
        x:DataType="vm:SyncViewModel"
        Title="Sync"
        Width="620" Height="680"
        MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Classes.handDrawn="{DynamicResource AppRingEnabled}">

  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="#1AFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Footer -->
    <Border DockPanel.Dock="Bottom" Padding="14,12" BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF">
      <StackPanel Spacing="10">

        <StackPanel Spacing="6" IsVisible="{Binding IsRunning}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" />
            <TextBlock Text="{Binding ProgressLabel}" Classes="hint" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="5" />
        </StackPanel>

        <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" FontSize="12"
                   IsVisible="{Binding ResultMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{Binding ResultIsFailure, Converter={StaticResource StatusBrush}}" />

        <ItemsControl ItemsSource="{Binding Failures}" MaxHeight="80">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:SyncItemResult">
              <TextBlock FontSize="10" Opacity="0.7" TextWrapping="Wrap"
                         Text="{Binding Error, StringFormat='• {0}'}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                    IsVisible="{Binding !IsRunning}">
          <Button Content="Retry outstanding" Command="{Binding RetryFailedCommand}"
                  IsVisible="{Binding HasFinished}" />
          <Button Content="Sync" MinWidth="110" Command="{Binding StartCommand}"
                  IsEnabled="{Binding HasWork}"
                  Background="#3322A0F2" BorderBrush="#6622A0F2" />
          <Button Content="Close" MinWidth="88" IsCancel="True" Click="OnClose" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="14,14" Spacing="12">

        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsPreparing}" />

        <!-- Summary -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Changes pending" FontWeight="SemiBold" FontSize="13" />
            <TextBlock FontSize="22" Text="{Binding FileCount, StringFormat='{}{0:N0} file(s)'}" />

            <ItemsControl ItemsSource="{Binding Breakdown}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Background="#1AFFFFFF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                    <TextBlock Text="{Binding}" FontSize="12" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="hint" IsVisible="{Binding !HasWork}"
                       Text="Nothing to sync — edit some metadata first." />
          </StackPanel>
        </Border>

        <!-- Resume notice -->
        <Border Classes="card" Background="#2622A0F2" BorderBrush="#6622A0F2"
                IsVisible="{Binding IsResuming}">
          <StackPanel Spacing="6">
            <TextBlock Text="Resuming a previous run" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Classes="hint"
                       Text="{Binding AlreadyCompletedCount, StringFormat='{}{0:N0} file(s) were already committed by an interrupted sync and will be skipped.'}" />
            <Button Content="Start over instead" FontSize="11" Padding="8,2" HorizontalAlignment="Left"
                    Command="{Binding DiscardResumeStateCommand}" />
          </StackPanel>
        </Border>

        <!-- Conflicts -->
        <Border Classes="card" Background="#26FF7043" BorderBrush="#66FF7043"
                IsVisible="{Binding HasConflicts}">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="SemiBold" FontSize="12"
                       Text="{Binding ConflictCount, StringFormat='⚠ {0:N0} file(s) have conflicting metadata'}" />
            <TextBlock Classes="hint"
                       Text="The values in these files disagree with the values in their XMP sidecars. Settle it in the inspector or the review, or let Sync skip them." />
            <CheckBox Content="Skip conflicted files" IsChecked="{Binding SkipConflicted}" />
          </StackPanel>
        </Border>

        <!-- Options -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Options" FontWeight="SemiBold" FontSize="13" />

            <StackPanel Spacing="4">
              <CheckBox Content="Embed metadata into the original files" IsChecked="{Binding EmbedMetadata}" />
              <TextBlock Classes="hint" Margin="24,0,0,0"
                         Text="Off by default. Everything Amberglass does otherwise leaves your originals byte-for-byte untouched; this is the one setting that changes them. Turn it on when another application needs the metadata inside the file." />
            </StackPanel>

            <StackPanel Spacing="4" IsEnabled="{Binding EmbedMetadata}">
              <CheckBox Content="Back up originals" IsChecked="{Binding BackupOriginals}" />
              <TextBlock Classes="hint" Margin="24,0,0,0"
                         Text="Keeps a copy as &lt;name&gt;.&lt;ext&gt;_original next to each file." />
            </StackPanel>

            <StackPanel Spacing="4" IsEnabled="{Binding EmbedMetadata}">
              <CheckBox Content="Preserve file timestamps" IsChecked="{Binding PreserveTimestamps}" />
              <TextBlock Classes="hint" Margin="24,0,0,0"
                         Text="Leaves the modification date alone, so writing metadata does not make every file look freshly edited." />
            </StackPanel>

            <StackPanel Spacing="4">
              <CheckBox Content="Validate after writing" IsChecked="{Binding ValidateAfterWriting}" />
              <TextBlock Classes="hint" Margin="24,0,0,0"
                         Text="Reads each file back and confirms it says what was asked for." />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- What will happen -->
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="What will happen" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Text="{Binding ActionSummary}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
