<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Amberglass.UI.ViewModels"
             xmlns:core="using:Amberglass.Core.Interfaces"
             mc:Ignorable="d"
             x:Class="Amberglass.UI.Views.BatchEditView"
             x:DataType="vm:BatchEditViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Margin" Value="0,8,0,3" />
    </Style>
    <Style Selector="Button.star">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#10FFFFFF" />
      <Setter Property="BorderBrush" Value="#18FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- Header -->
    <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="#18FFFFFF">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" FontSize="14" />
        <TextBlock Classes="label" Margin="0,2,0,0"
                   Text="Only ticked fields are applied. Nothing is written until you save." />
      </StackPanel>
    </Border>

    <!-- Footer: run / progress / result -->
    <Border DockPanel.Dock="Bottom" Padding="12,10" BorderThickness="0,1,0,0" BorderBrush="#18FFFFFF">
      <StackPanel Spacing="8">

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsRunning}">
          <Button Content="Apply to selection" Command="{Binding ApplyCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Content="Clear" Command="{Binding ClearFormCommand}" />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding IsRunning}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Cancel" FontSize="11" Padding="8,2"
                    Command="{Binding CancelJobCommand}" />
            <TextBlock Text="{Binding ProgressLabel}" FontSize="11" Opacity="0.7"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="4" />
        </StackPanel>

        <TextBlock Text="{Binding ResultMessage}" FontSize="11" TextWrapping="Wrap"
                   IsVisible="{Binding ResultMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{Binding ResultIsFailure, Converter={StaticResource StatusBrush}}" />

        <ItemsControl ItemsSource="{Binding Failures}" MaxHeight="90">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:BatchFailure">
              <TextBlock FontSize="10" Opacity="0.7" TextWrapping="Wrap"
                         Text="{Binding Reason, StringFormat='• {0}'}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="12,8" Spacing="10">

        <!-- Keywords -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <DockPanel>
              <Button DockPanel.Dock="Right" FontSize="11" Padding="8,2"
                      Content="Paste copied"
                      IsEnabled="{Binding CanPasteKeywords}"
                      ToolTip.Tip="{Binding PasteKeywordsSummary}"
                      Command="{Binding PasteKeywordsCommand}" />
              <TextBlock Text="Keywords" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>

            <CheckBox Content="Replace all keywords" IsChecked="{Binding ReplaceKeywords}"
                      ToolTip.Tip="Discards each file's existing keywords. Off by default because that is rarely what a mixed selection needs." />

            <TextBlock Classes="label"
                       Text="{Binding ReplaceKeywords, Converter={StaticResource KeywordHeading}}" />
            <ItemsControl ItemsSource="{Binding KeywordsToAdd}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Background="#2840C463" CornerRadius="10" Padding="8,3" Margin="0,0,4,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                      <Button Content="✕" FontSize="9" Padding="2,0" MinWidth="0" VerticalAlignment="Center"
                              Background="Transparent" BorderThickness="0"
                              Command="{Binding $parent[ItemsControl].((vm:BatchEditViewModel)DataContext).RemoveFromAddCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Add" Margin="4,0,0,0"
                      Command="{Binding AddKeywordToAddCommand}" />
              <TextBox Text="{Binding NewKeywordToAdd}" Watermark="Keyword…">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding AddKeywordToAddCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </DockPanel>

            <StackPanel Spacing="6" IsVisible="{Binding !ReplaceKeywords}">
              <TextBlock Text="Remove these keywords" Classes="label" />
              <ItemsControl ItemsSource="{Binding KeywordsToRemove}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Background="#28FF6B6B" CornerRadius="10" Padding="8,3" Margin="0,0,4,4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                        <Button Content="✕" FontSize="9" Padding="2,0" MinWidth="0" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding $parent[ItemsControl].((vm:BatchEditViewModel)DataContext).RemoveFromRemoveCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add" Margin="4,0,0,0"
                        Command="{Binding AddKeywordToRemoveCommand}" />
                <TextBox Text="{Binding NewKeywordToRemove}" Watermark="Keyword to remove…">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddKeywordToRemoveCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Rating -->
        <Border Classes="card">
          <StackPanel Spacing="4">
            <CheckBox Content="Set rating" IsChecked="{Binding ApplyRating}" />
            <StackPanel Orientation="Horizontal">
              <Button Classes="star" Content="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=1}"
                      Command="{Binding SetRatingCommand}" CommandParameter="1" />
              <Button Classes="star" Content="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=2}"
                      Command="{Binding SetRatingCommand}" CommandParameter="2" />
              <Button Classes="star" Content="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=3}"
                      Command="{Binding SetRatingCommand}" CommandParameter="3" />
              <Button Classes="star" Content="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=4}"
                      Command="{Binding SetRatingCommand}" CommandParameter="4" />
              <Button Classes="star" Content="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=5}"
                      Command="{Binding SetRatingCommand}" CommandParameter="5" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Text fields -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <CheckBox Content="Set title" IsChecked="{Binding ApplyTitle}" />
            <TextBox Text="{Binding Title}" />

            <CheckBox Content="Set headline" IsChecked="{Binding ApplyHeadline}" Margin="0,4,0,0" />
            <TextBox Text="{Binding Headline}" />

            <CheckBox Content="Set description" IsChecked="{Binding ApplyDescription}" Margin="0,4,0,0" />
            <TextBox Text="{Binding Description}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />

            <CheckBox Content="Set label" IsChecked="{Binding ApplyLabel}" Margin="0,4,0,0" />
            <TextBox Text="{Binding Label}" />

            <CheckBox Content="Set creator" IsChecked="{Binding ApplyCreator}" Margin="0,4,0,0" />
            <TextBox Text="{Binding Creator}" />

            <CheckBox Content="Set copyright" IsChecked="{Binding ApplyCopyright}" Margin="0,4,0,0" />
            <TextBox Text="{Binding Copyright}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
