<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Amberglass.UI.Views.ImportPreviewWindow"
        Title="Import from workspace"
        Width="440" Height="480"
        MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="16">

    <!-- Actions on the bottom, so a long list scrolls under them rather than pushing them away. -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" MinWidth="88" IsCancel="True" Click="OnCancel" />
      <Button x:Name="ConfirmButton" Content="Import" MinWidth="88" IsDefault="True" Click="OnConfirm" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,4" />

    <TextBlock DockPanel.Dock="Top" x:Name="Reassurance" TextWrapping="Wrap"
               FontSize="11" Opacity="0.55" Margin="0,0,0,10"
               Text="Nothing is written to your photographs, and nothing you have already arranged is moved." />

    <!--
      Two lists sharing the height. Whichever one carries the answer gets the room: normally the
      one being added, and when there is nothing to add, the one explaining why. The rows are sized
      in code, because an empty bordered box is worse than no box.
    -->
    <Grid x:Name="Lists" RowDefinitions="*,Auto">

      <DockPanel x:Name="AddSection" Grid.Row="0">
        <TextBlock DockPanel.Dock="Top" x:Name="AddHeading" FontSize="11" Opacity="0.6" Margin="0,0,0,4" />
        <Border Background="#12FFFFFF" CornerRadius="4" Padding="8">
          <ScrollViewer>
            <ItemsControl x:Name="AddList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="12" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>

      <DockPanel x:Name="KnownSection" Grid.Row="1" Margin="0,10,0,0">
        <TextBlock DockPanel.Dock="Top" x:Name="KnownHeading" FontSize="11" Opacity="0.6" Margin="0,0,0,4" />
        <Border x:Name="KnownBox" Background="#12FFFFFF" CornerRadius="4" Padding="8" MaxHeight="120">
          <ScrollViewer>
            <ItemsControl x:Name="KnownList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="12" Opacity="0.55" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>

    </Grid>

  </DockPanel>
</Window>
