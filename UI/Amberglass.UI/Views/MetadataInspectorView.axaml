<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Amberglass.UI.ViewModels"
             xmlns:core="using:Amberglass.Core.Models"
             xmlns:controls="using:Amberglass.UI.Controls"
             mc:Ignorable="d"
             x:Class="Amberglass.UI.Views.MetadataInspectorView"
             x:DataType="vm:MetadataInspectorViewModel">

  <UserControl.Styles>
    <!--
      Group headers in the All tags tab. The theme sizes an Expander header to be clicked once in a
      settings page; here there are eight of them stacked, and at that height the list of sections
      takes more room than the tags it is meant to be condensing.

      Targeted by type rather than by template part name: the header is the only ToggleButton in
      the template, and a name would be one more thing to get wrong across a theme upgrade. Scoped
      to .group so the keyword library Expander in this same view is left alone.
    -->
    <!--
      Padding zero because the theme reserves the content area's padding even while the section is
      shut, which put a band of empty space under every collapsed header — most of the height of the
      list was gaps between sections rather than sections. The tags supply their own inset instead,
      so the expanded state is unchanged.
    -->
    <Style Selector="Expander.group">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!--
      Height, not MinHeight: the theme fixes the header's height somewhere a setter on the button
      does not reach, and MinHeight on it, on its inner Border and on its ContentPresenter all left
      it at 33pt. An explicit height overrides it outright, and is honest here — every header is one
      line of one size, so there is nothing for it to need to grow for.
    -->
    <Style Selector="Expander.group /template/ ToggleButton">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Margin" Value="0,10,0,3" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.star">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <!-- Fluent's default tab headers are large enough that four of them wrap in this column. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="0" />

      <!--
        One template for every tab rather than four hand-written headers. HoverKind is None: the
        tabs keep their ordinary hover highlight, and only the chosen one is drawn. The bottom
        margin is what the underline is drawn in, so it does not cross the descenders of the label.
      -->
      <Setter Property="HeaderTemplate">
        <DataTemplate>
          <Panel>
            <controls:RoughMark Kind="Underline" HoverKind="None"
                                IsSelected="{Binding $parent[TabItem].IsSelected}" />
            <TextBlock Text="{Binding}" Margin="0,0,0,4" />
          </Panel>
        </DataTemplate>
      </Setter>
    </Style>
    <!-- A field is hidden entirely when it has no value, so no empty row is left behind. -->
    <Style Selector="StackPanel.field">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Styles>

  <Panel>

    <!-- Nothing selected -->
    <TextBlock Text="No item selected" Opacity="0.4"
               HorizontalAlignment="Center" Margin="0,24,0,0"
               IsVisible="{Binding !HasItem}" />

    <DockPanel IsVisible="{Binding HasItem}">

      <!-- ExifTool missing: metadata cannot be read at all, so it belongs at the top of the panel. -->
      <Border DockPanel.Dock="Top"
              IsVisible="{Binding !IsMetadataEngineAvailable}"
              Background="#26FFC107" BorderBrush="#66FFC107" BorderThickness="1"
              CornerRadius="6" Padding="12,10" Margin="8,8,8,0">
        <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚠" FontSize="14" Foreground="#FFC107" VerticalAlignment="Center" />
            <TextBlock Text="ExifTool is not installed" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Metadata cannot be read or edited until ExifTool is installed. Browsing and thumbnails work as normal."
                     TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
          <TextBlock Text="{x:Static vm:MetadataInspectorViewModel.ExifToolInstallHint}"
                     FontFamily="monospace" FontSize="12" Opacity="0.9" TextWrapping="Wrap" />
          <TextBlock Text="Restart Amberglass after installing." FontSize="11" Opacity="0.55" />
        </StackPanel>
      </Border>

      <!-- Pending / conflict / sidecar status strip -->
      <StackPanel DockPanel.Dock="Top" Margin="8,8,8,0" Spacing="6">

        <!-- Conflicts come first: the user should settle them before committing anything. -->
        <Border IsVisible="{Binding HasConflicts}"
                Background="#26FF7043" BorderBrush="#66FF7043" BorderThickness="1"
                CornerRadius="4" Padding="8,6">
          <StackPanel Spacing="6">
            <TextBlock Text="⚠ This file and its XMP sidecar disagree"
                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding Conflicts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:MetadataConflict">
                  <Grid ColumnDefinitions="72,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Field}" FontSize="11" Opacity="0.7"
                               VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                      <TextBlock FontSize="11" TextWrapping="Wrap"
                                 Text="{Binding EmbeddedValue, StringFormat='in the file: {0}'}" />
                      <TextBlock FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                                 Text="{Binding SidecarValue, StringFormat='in the sidecar: {0}'}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
              Before the three answers, a way to see the question. The list above is cramped at this
              width and says nothing about which value is the one currently in use.
            -->
            <Button Content="Compare side by side…" FontSize="11" Padding="8,2"
                    HorizontalAlignment="Left"
                    ToolTip.Tip="Open the review with this file's two readings laid out field by field"
                    Command="{Binding CompareConflictsCommand}" />

            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Keep the file's" FontSize="11" Padding="8,2"
                      Command="{Binding ResolveConflictsCommand}" CommandParameter="KeepEmbedded" />
              <Button Content="Keep the sidecar's" FontSize="11" Padding="8,2"
                      Command="{Binding ResolveConflictsCommand}" CommandParameter="KeepSidecar" />
              <Button Content="Merge" FontSize="11" Padding="8,2"
                      ToolTip.Tip="Union the keywords; the sidecar wins for single-valued fields"
                      Command="{Binding ResolveConflictsCommand}" CommandParameter="Merge" />
            </StackPanel>
            <!-- Writing the sidecar does not change the copy inside the media file, so this warning
                 legitimately persists after saving. Saying so up front stops that looking like a bug. -->
            <TextBlock Text="Resolving records a pending change — nothing is written until you save. Saving updates the sidecar only; the copy inside the media file changes during Sync."
                       FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </StackPanel>

      <!--
        Everything about saving, along the bottom edge.

        It used to sit above the fields, which meant that the moment anything was edited the whole
        panel jumped down by the height of this banner — on every edit, since editing is exactly
        what makes it appear. Docked to the bottom it grows into the panel's own edge and nothing
        above it moves. The conflict warning stays at the top, because that one is asking to be
        settled before any of the fields below it are touched, and it is rare enough not to jar.
      -->
      <StackPanel DockPanel.Dock="Bottom" Margin="8,6,8,8" Spacing="6">
        <Border IsVisible="{Binding HasPendingChanges}"
                Background="#2622A0F2" BorderBrush="#6622A0F2" BorderThickness="1"
                CornerRadius="4" Padding="8,6">
          <StackPanel Spacing="6">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Revert" FontSize="11" Padding="8,2"
                      Command="{Binding RevertChangesCommand}" />
              <TextBlock Text="● Modified — not yet written to disk" FontSize="12"
                         VerticalAlignment="Center" />
            </DockPanel>
            <Button Content="Write XMP sidecar" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding !IsWriting}"
                    IsVisible="{Binding CanWriteSidecar}"
                    Command="{Binding WriteSidecarCommand}" />
            <TextBlock Text="Writes &lt;name&gt;.xmp next to the file. The original media is not modified."
                       FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TextBlock FontSize="11" TextWrapping="Wrap"
                   IsVisible="{Binding WriteStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding WriteStatus}"
                   Foreground="{Binding WriteFailed, Converter={StaticResource StatusBrush}}" />

        <ProgressBar IsIndeterminate="True" Height="3"
                     IsVisible="{Binding IsLoading}" />
        <ProgressBar IsIndeterminate="True" Height="3"
                     IsVisible="{Binding IsWriting}" />
      </StackPanel>

      <TabControl Margin="4,6,4,4" SelectedIndex="{Binding SelectedTabIndex}"
                  Classes.handDrawn="{DynamicResource AppRingEnabled}">

        <!-- ============ General (editable) ============ -->
        <TabItem Header="General">
          <!--
            Three rows so the library can take the space nobody else wants. The row heights come from
            the ViewModel: expanded, the library gets the star and the fields below it sit under it;
            collapsed, the slack goes to the bottom and everything hugs the top as before.

            MinHeight ties the grid to the viewport, which is what makes the star row mean anything —
            a grid inside a ScrollViewer is otherwise measured against infinite height, and a star row
            of infinite height collapses to its content. Above the viewport height it grows and the
            ScrollViewer does its job.
          -->
          <ScrollViewer x:Name="GeneralScroll">
            <Grid x:Name="GeneralGrid" RowDefinitions="Auto,Auto,Auto"
                  MinHeight="{Binding #GeneralScroll.Bounds.Height}">

            <StackPanel Grid.Row="0" Margin="8,4,8,0">

              <StackPanel IsVisible="{Binding ShowRating}">
              <TextBlock Text="Rating" Classes="label" />
              <StackPanel Orientation="Horizontal">
                <Button Classes="star" Content="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=1}"
                        Command="{Binding SetRatingCommand}" CommandParameter="1" />
                <Button Classes="star" Content="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=2}"
                        Command="{Binding SetRatingCommand}" CommandParameter="2" />
                <Button Classes="star" Content="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=3}"
                        Command="{Binding SetRatingCommand}" CommandParameter="3" />
                <Button Classes="star" Content="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=4}"
                        Command="{Binding SetRatingCommand}" CommandParameter="4" />
                <Button Classes="star" Content="{Binding Rating, Converter={StaticResource StarGlyph}, ConverterParameter=5}"
                        Command="{Binding SetRatingCommand}" CommandParameter="5" />
              </StackPanel>
              </StackPanel>

              <!--
                The cull decision, beside the rating because they are made in the same pass. Written
                to three XMP conventions so Bridge, digiKam and Photo Mechanic each find one they
                understand — see MediaFlag.
              -->
              <StackPanel>
                <TextBlock Text="Flag" Classes="label" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ToggleButton Content="✓ Keep" FontSize="11" Padding="9,3"
                                IsChecked="{Binding IsAccepted, Mode=OneWay}"
                                Command="{Binding SetFlagCommand}" CommandParameter="accept"
                                ToolTip.Tip="Mark as a keeper. Leaves the rating alone." />
                  <ToggleButton Content="✕ Reject" FontSize="11" Padding="9,3"
                                IsChecked="{Binding IsRejected, Mode=OneWay}"
                                Command="{Binding SetFlagCommand}" CommandParameter="reject"
                                ToolTip.Tip="Mark as a reject. Clears the rating, because Adobe stores a rejection as a rating of -1." />
                </StackPanel>
              </StackPanel>

              <StackPanel IsVisible="{Binding ShowTitle}">
                <TextBlock Text="Title" Classes="label" />
                <TextBox Text="{Binding Title}" />
              </StackPanel>

              <StackPanel IsVisible="{Binding ShowHeadline}">
                <TextBlock Text="Headline" Classes="label" />
                <TextBox Text="{Binding Headline}" />
              </StackPanel>

              <StackPanel IsVisible="{Binding ShowDescription}">
                <TextBlock Text="Description" Classes="label" />
                <TextBox Text="{Binding Description}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="70" MaxHeight="140" />
              </StackPanel>

              <!--
                Label before Keywords: it is one pick from a short list, made in the same pass as the
                rating and flag, where keywords open onto the library below them and want to sit next
                to it. Transparent for the same reason as the Keywords field: without it a right-click
                in the gaps lands on nothing.
              -->
              <StackPanel IsVisible="{Binding ShowLabel}" Background="Transparent">
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Manage labels…" Click="OnManageLabels" />
                  </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="Label" Classes="label" />
                <!--
                  From the library, like keywords. A label the file already carries that the library
                  does not define is added to the list rather than dropped, so opening the file
                  cannot quietly rewrite it.
                -->
                <ComboBox ItemsSource="{Binding LabelChoices}"
                          SelectedItem="{Binding SelectedLabelChoice}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LabelChoice">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="11" Height="11" CornerRadius="2" VerticalAlignment="Center"
                                Background="{Binding Colour}" IsVisible="{Binding HasColour}" />
                        <Border Width="11" Height="11" CornerRadius="2" VerticalAlignment="Center"
                                BorderBrush="#55FFFFFF" BorderThickness="1"
                                IsVisible="{Binding !HasColour}" />
                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!--
                Transparent so the empty space between the pills and the input is hit-testable:
                without it a right-click only lands when it happens to strike a word.
              -->
              <StackPanel IsVisible="{Binding ShowKeywords}" Background="Transparent">
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Manage keywords…" Click="OnManageKeywords" />
                  </ContextMenu>
                </StackPanel.ContextMenu>
              <TextBlock Text="Keywords" Classes="label" />
              <ItemsControl ItemsSource="{Binding AppliedKeywords}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AppliedKeyword">
                    <Panel>
                      <!-- A keyword. -->
                      <Border Background="#28FFFFFF" CornerRadius="10" Padding="8,3" Margin="0,0,4,4"
                              IsVisible="{Binding !IsCopyAction}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />

                          <!-- Keywords that arrived with the file, which no library will ever have all
                               of. Adopted where they are noticed rather than in a cleanup pass. -->
                          <Button Content="+" FontSize="10" Padding="2,0" MinWidth="0"
                                  Background="Transparent" BorderThickness="0"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding !IsInLibrary}"
                                  ToolTip.Tip="Add this keyword to your library"
                                  Command="{Binding $parent[ItemsControl].((vm:MetadataInspectorViewModel)DataContext).AdoptKeywordCommand}"
                                  CommandParameter="{Binding Name}" />

                          <Button Content="✕" FontSize="9" Padding="2,0" MinWidth="0"
                                  Background="Transparent" BorderThickness="0"
                                  VerticalAlignment="Center"
                                  Command="{Binding $parent[ItemsControl].((vm:MetadataInspectorViewModel)DataContext).RemoveKeywordCommand}"
                                  CommandParameter="{Binding Name}" />
                        </StackPanel>
                      </Border>

                      <!-- The copy pill, trailing the set it copies. Outlined rather than filled, so
                           it reads as an action among the keywords without competing with them. -->
                      <Button IsVisible="{Binding IsCopyAction}"
                              Content="Copy" FontSize="11" Padding="8,2" Margin="0,0,4,4"
                              Background="Transparent" BorderBrush="#33FFFFFF" BorderThickness="1"
                              CornerRadius="10" Foreground="#99FFFFFF"
                              ToolTip.Tip="Copy these keywords, then paste them onto a selection from the grid"
                              Command="{Binding $parent[ItemsControl].((vm:MetadataInspectorViewModel)DataContext).CopyKeywordsCommand}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add" Margin="4,0,0,0"
                        Command="{Binding AddKeywordCommand}" />
                <TextBox Text="{Binding NewKeyword}" Watermark="{Binding KeywordInputWatermark}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddKeywordCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </DockPanel>

              <!--
                Matches for what has been typed. Flat, because while searching the answer is a short
                list of candidates and the shape of the tree only gets in the way of picking one.
              -->
              <Border IsVisible="{Binding IsSearchingKeywords}"
                      Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                      CornerRadius="4" Padding="4" Margin="0,4,0,0">
                <StackPanel Spacing="4">
                  <ItemsControl ItemsSource="{Binding KeywordMatches}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:KeywordPickerNodeViewModel">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="6,3"
                                FontSize="12"
                                Content="{Binding Name}"
                                Command="{Binding $parent[ItemsControl].((vm:MetadataInspectorViewModel)DataContext).ApplyFromLibraryCommand}"
                                CommandParameter="{Binding Name}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Nothing matched. How a vocabulary grows, so it is offered rather than refused. -->
                  <Button IsVisible="{Binding CanAddTypedKeywordToLibrary}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          FontSize="12" Padding="6,3"
                          Background="#2622A0F2" BorderBrush="#4422A0F2"
                          Content="{Binding AddToLibraryPrompt}"
                          Command="{Binding AddTypedKeywordToLibraryCommand}" />
                </StackPanel>
              </Border>

              <!--
                Nothing to tick from yet. Says what to do and offers to take them there, rather than
                opening Settings unasked in the middle of whatever they were doing.
              -->
              <Border IsVisible="{Binding !HasKeywordLibrary}" Margin="0,6,0,0"
                      Background="#2622A0F2" BorderBrush="#6622A0F2" BorderThickness="1"
                      CornerRadius="6" Padding="10,8">
                <StackPanel Spacing="6">
                  <TextBlock Text="No keyword library yet" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.8"
                             Text="Set up your own keywords once and they become a tick list here — far quicker than typing them for every photograph." />
                  <Button Content="Set up keywords…" FontSize="11" HorizontalAlignment="Left"
                          Click="OnSetUpKeywords" />
                </StackPanel>
              </Border>


              </StackPanel>
            </StackPanel>

              <!--
                The library, folded away by default so the panel stays about this photograph. Its
                open state is bound to the ViewModel rather than kept by the Expander, which is what
                lets it stay open across a change of selection — tagging a folder means tagging one
                and moving to the next, and a panel that refolded itself each time would be reopened
                once per photograph.
              -->
            <!--
              10 on top, the same as the label heading every other field starts with, so the gap
              above the library matches the gap between any two fields whether or not the Keywords
              field above it is shown.
            -->
            <Expander Grid.Row="1" Margin="8,10,8,0" IsExpanded="{Binding IsKeywordLibraryOpen}"
                        IsVisible="{Binding HasKeywordLibrary}"
                        HorizontalAlignment="Stretch">
                <!-- The same entry as on the Keywords field above: this is the other half of the
                     keyword area, and either is a reasonable place to go looking for it. -->
                <Expander.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Manage keywords…" Click="OnManageKeywords" />
                  </ContextMenu>
                </Expander.ContextMenu>
                <Expander.Header>
                  <TextBlock Text="Keyword library" FontSize="12" />
                </Expander.Header>

                <ScrollViewer MinHeight="120" HorizontalScrollBarVisibility="Disabled">
                  <TreeView ItemsSource="{Binding KeywordPicker}"
                            Background="Transparent" BorderThickness="0">
                    <TreeView.Styles>
                      <Style Selector="TreeViewItem" x:DataType="vm:KeywordPickerNodeViewModel">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                      </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                      <TreeDataTemplate x:DataType="vm:KeywordPickerNodeViewModel" ItemsSource="{Binding Children}">
                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,-2">
                          <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                        </CheckBox>
                      </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                </ScrollViewer>
              </Expander>

            <StackPanel Grid.Row="2" Margin="8,0,8,4">

              <StackPanel IsVisible="{Binding ShowCreator}">
                <TextBlock Text="Creator" Classes="label" />
                <TextBox Text="{Binding Creator}" />
              </StackPanel>

              <StackPanel IsVisible="{Binding ShowCopyright}">
                <TextBlock Text="Copyright" Classes="label" />
                <TextBox Text="{Binding Copyright}" />
              </StackPanel>

            </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <!-- ============ Camera (read-only) ============ -->
        <TabItem Header="Camera">
          <ScrollViewer>
            <StackPanel Margin="8,4" DataContext="{Binding Camera}" x:DataType="core:CameraInfo">
              <TextBlock Text="No camera metadata" Opacity="0.4" Margin="0,12,0,0"
                         IsVisible="{Binding IsEmpty}" />

              <StackPanel Classes="field" IsVisible="{Binding Camera, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Camera" Classes="label" />
                <TextBlock Text="{Binding Camera}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding Lens, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Lens" Classes="label" />
                <TextBlock Text="{Binding Lens}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding Iso, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="ISO" Classes="label" />
                <TextBlock Text="{Binding Iso}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding ShutterSpeed, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Shutter speed" Classes="label" />
                <TextBlock Text="{Binding ShutterSpeed}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding Aperture, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Aperture" Classes="label" />
                <TextBlock Text="{Binding Aperture}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding FocalLength, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Focal length" Classes="label" />
                <TextBlock Text="{Binding FocalLength}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding CaptureDate, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Capture date" Classes="label" />
                <TextBlock Text="{Binding CaptureDate}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding Gps, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="GPS" Classes="label" />
                <TextBlock Text="{Binding Gps}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding Orientation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Orientation" Classes="label" />
                <TextBlock Text="{Binding Orientation}" Classes="value" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ============ Video (read-only) ============ -->
        <TabItem Header="Video" IsVisible="{Binding IsVideo}">
          <ScrollViewer>
            <StackPanel Margin="8,4" DataContext="{Binding Video}" x:DataType="core:VideoInfo">
              <TextBlock Text="No video metadata" Opacity="0.4" Margin="0,12,0,0"
                         IsVisible="{Binding IsEmpty}" />

              <StackPanel Classes="field" IsVisible="{Binding Codec, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Codec" Classes="label" />
                <TextBlock Text="{Binding Codec}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding Resolution, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Resolution" Classes="label" />
                <TextBlock Text="{Binding Resolution}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding FrameRate, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Frame rate" Classes="label" />
                <TextBlock Text="{Binding FrameRate}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding Duration, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Duration" Classes="label" />
                <TextBlock Text="{Binding Duration}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding Bitrate, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Bitrate" Classes="label" />
                <TextBlock Text="{Binding Bitrate}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding ColourSpace, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Colour space" Classes="label" />
                <TextBlock Text="{Binding ColourSpace}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding HdrInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="HDR" Classes="label" />
                <TextBlock Text="{Binding HdrInfo}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding AudioCodec, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Audio codec" Classes="label" />
                <TextBlock Text="{Binding AudioCodec}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding AudioChannels, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Audio channels" Classes="label" />
                <TextBlock Text="{Binding AudioChannels}" Classes="value" />
              </StackPanel>

              <StackPanel Classes="field" IsVisible="{Binding AudioSampleRate, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Audio sample rate" Classes="label" />
                <TextBlock Text="{Binding AudioSampleRate}" Classes="value" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!--
          ============ All tags ============
          Everything ExifTool reads from the file (EXIF, maker notes, embedded XMP, IPTC…), plus the
          sidecar's tags grouped under "Sidecar:" when there is one. Not called "XMP": most files
          have no sidecar and most of what is listed here never came from XMP.
        -->
        <TabItem Header="All tags">
          <DockPanel Margin="8,4">
            <!--
              Filter box rather than a Cmd+F overlay: it is visible, so it needs no discovering,
              and it leaves Cmd+F meaning the one thing it means everywhere else in the window.
            -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
              <TextBox x:Name="RawTagFilterBox" Classes="compact" FontSize="12"
                       Text="{Binding RawTagFilter}"
                       Watermark="Filter tags — name or value" />
              <!-- Centred against the box beside it, which is now shorter than a default Button. -->
              <Button Grid.Column="1" Content="✕" FontSize="11" Margin="4,0,0,0"
                      Background="Transparent" BorderThickness="0" Padding="6,3"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsFilteringRawTags}"
                      Command="{Binding ClearRawTagFilterCommand}"
                      ToolTip.Tip="Clear the filter" />
            </Grid>

            <TextBlock DockPanel.Dock="Top" FontSize="11" Opacity="0.5" Margin="0,0,0,6"
                       Text="{Binding RawTagFilterSummary}"
                       IsVisible="{Binding IsFilteringRawTags}" />

            <TextBlock DockPanel.Dock="Top" FontSize="12" Opacity="0.5" Margin="0,6,0,0"
                       Text="No tag matches that."
                       IsVisible="{Binding HasNoRawTagMatches}" />

            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding RawTagGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RawMetadataGroupViewModel">
                    <!--
                      The heading rides on the first section of each half rather than being an item
                      of its own, so the list stays one collection of groups and the filter and the
                      remembered open sections need not know headings exist.
                    -->
                    <StackPanel>
                      <TextBlock Classes="label" Text="{Binding SectionHeading}"
                                 Margin="2,10,0,4"
                                 IsVisible="{Binding SectionHeading, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <Expander Classes="group"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Margin="0,0,0,2">
                        <Expander.Header>
                          <!-- The count sits hard right, so the eye runs down one column of sizes. -->
                          <DockPanel>
                            <TextBlock Text="{Binding Summary}" DockPanel.Dock="Right"
                                       FontSize="11" Opacity="0.45" VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                          </DockPanel>
                        </Expander.Header>
                        <!-- The inset the Expander's own Padding used to give, now that it is zero. -->
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="10,4,10,8">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:RawMetadataTag">
                              <!-- Name alone, not Group:Name: the section header already said the group. -->
                              <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.6" />
                                <TextBlock Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

      </TabControl>
    </DockPanel>
  </Panel>
</UserControl>
