<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Amberglass.UI.ViewModels"
        xmlns:core="using:Amberglass.Core.Models"
        xmlns:controls="using:Amberglass.UI.Controls"
        mc:Ignorable="d"
        x:Class="Amberglass.UI.Views.ChangesWindow"
        x:DataType="vm:ChangesViewModel"
        Title="Changes"
        Width="960" Height="640"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Classes.handDrawn="{DynamicResource AppRingEnabled}">

  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.column">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- The two sides of a diff. Muted for what was, plain for what will be. -->
    <Style Selector="TextBlock.was">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.now">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Only when closing the application brought us here. -->
    <Border DockPanel.Dock="Top" Padding="14,10" Background="#26FFC107"
            BorderThickness="0,0,0,1" BorderBrush="#66FFC107"
            IsVisible="{Binding IsQuitPrompt}">
      <TextBlock Text="{Binding QuitBanner}" FontSize="12" TextWrapping="Wrap" />
    </Border>

    <!-- Footer: what the buttons will act on, and the buttons. -->
    <Border DockPanel.Dock="Bottom" Padding="14,10" BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Discard" Command="{Binding DiscardSelectedCommand}"
                  IsEnabled="{Binding HasChanges}"
                  ToolTip.Tip="Forget the selected files' edits. Nothing on disk changes — nothing was ever written." />
          <Button Content="Write sidecars" Command="{Binding WriteSelectedCommand}"
                  IsEnabled="{Binding HasChanges}"
                  ToolTip.Tip="Write the selected files' changes to their XMP sidecars. Original media is not modified." />
          <Button Content="Close" MinWidth="88" IsCancel="True" Click="OnClose" />
          <Button Content="Quit without saving" Click="OnQuitAnyway"
                  IsVisible="{Binding IsQuitPrompt}"
                  ToolTip.Tip="Close the application and lose every change still listed here" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectionSummary}" Classes="hint" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Padding="0" SelectedIndex="{Binding SelectedTab}">

      <!-- ============================================================ Changes -->
      <TabItem Header="Changes">
        <Panel>
          <TextBlock Text="Nothing pending. Edits made in the inspector or the batch editor appear here until they are written or discarded."
                     Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center"
                     MaxWidth="360" TextAlignment="Center"
                     IsVisible="{Binding !HasChanges}" />

          <Grid ColumnDefinitions="320,4,*" IsVisible="{Binding HasChanges}">

            <!-- The files. -->
            <DockPanel Grid.Column="0">
              <Border DockPanel.Dock="Top" Padding="12,10,12,8">
                <TextBlock Text="{Binding Heading}" Classes="heading" />
              </Border>

              <!--
                Multi-select, and the selection is what the buttons act on. A single click still
                selects one file for the diff; shift and command extend it for the commands.
              -->
              <ListBox ItemsSource="{Binding Files}"
                       SelectedItem="{Binding SelectedFile}"
                       SelectedItems="{Binding SelectedFiles}"
                       SelectionMode="Multiple"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChangedFileViewModel">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,10,0"
                              Background="#18FFFFFF" CornerRadius="3">
                        <controls:LazyThumbnail DataContext="{Binding Item}"
                                                Source="{Binding Thumbnail}"
                                                Stretch="Uniform" Margin="2" />
                      </Border>
                      <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Folder}" Classes="hint"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#5CB8F5"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#22FFFFFF" />

            <!-- The diff for the file in view. -->
            <ScrollViewer Grid.Column="2" Padding="16,10,16,16">
              <StackPanel Spacing="12" DataContext="{Binding SelectedFile}"
                          x:DataType="vm:ChangedFileViewModel">

                <DockPanel>
                  <Border DockPanel.Dock="Left" Width="96" Height="96" Margin="0,0,14,0"
                          Background="#18FFFFFF" CornerRadius="3">
                    <controls:LazyThumbnail DataContext="{Binding Item}"
                                            Source="{Binding Thumbnail}"
                                            Stretch="Uniform" Margin="3" />
                  </Border>
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Folder}" Classes="hint" />
                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#5CB8F5" />
                  </StackPanel>
                </DockPanel>

                <!-- Column headings, then one row per field that differs. -->
                <Grid ColumnDefinitions="110,*,*" Margin="0,6,0,0">
                  <TextBlock Grid.Column="0" Text="FIELD" Classes="column" />
                  <TextBlock Grid.Column="1" Text="WAS" Classes="column" />
                  <TextBlock Grid.Column="2" Text="NOW" Classes="column" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="0" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.DataTemplates>

                    <DataTemplate DataType="vm:FieldRow">
                      <Border Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="#14FFFFFF">
                        <Grid ColumnDefinitions="110,*,*">
                          <TextBlock Grid.Column="0" Text="{Binding Field}" FontSize="12" Opacity="0.7" />
                          <TextBlock Grid.Column="1" Text="{Binding WasText}" Classes="was" FontSize="12"
                                     Margin="0,0,12,0" />
                          <TextBlock Grid.Column="2" Text="{Binding NowText}" Classes="now" FontSize="12" />
                        </Grid>
                      </Border>
                    </DataTemplate>

                    <!--
                      A keyword row is a sign and a word, not a before and an after. Added sits in
                      the NOW column and removed in WAS, so the eye keeps reading the same two
                      columns as for every other field.
                    -->
                    <DataTemplate DataType="vm:KeywordRow">
                      <Border Padding="0,5" BorderThickness="0,0,0,1" BorderBrush="#14FFFFFF">
                        <Grid ColumnDefinitions="110,*,*">
                          <TextBlock Grid.Column="0" Text="Keyword" FontSize="12" Opacity="0.7" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                      IsVisible="{Binding !Added}">
                            <TextBlock Text="−" FontSize="12" Foreground="#E8574A" />
                            <TextBlock Text="{Binding Keyword}" Classes="was" FontSize="12" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                      IsVisible="{Binding Added}">
                            <TextBlock Text="+" FontSize="12" Foreground="#6ABF52" />
                            <TextBlock Text="{Binding Keyword}" Classes="now" FontSize="12" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>

                  </ItemsControl.DataTemplates>
                </ItemsControl>

              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Panel>
      </TabItem>

      <!-- ============================================================ Conflicts -->
      <TabItem Header="Conflicts">
        <DockPanel>

          <!-- The check is an explicit action: it reads every file on screen. -->
          <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="#1AFFFFFF">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCheckCommand}"
                        IsVisible="{Binding IsChecking}" />
                <Button Content="{Binding CheckLabel}" Command="{Binding CheckConflictsCommand}"
                        IsEnabled="{Binding !IsChecking}"
                        ToolTip.Tip="Read every file currently shown in the grid and list those whose own values disagree with their sidecar" />
              </StackPanel>
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding ConflictHeading}" Classes="heading" />
                <ProgressBar Minimum="0" Maximum="{Binding ScopeCount}" Value="{Binding CheckProgress}"
                             Height="4" IsVisible="{Binding IsChecking}" />
                <TextBlock Text="{Binding CheckStatus}" Classes="hint" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Panel>
            <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="380" TextAlignment="Center"
                       IsVisible="{Binding !HasConflicts}"
                       Text="A conflict is a field where the file and its XMP sidecar both have a value and disagree. Check the files on screen to find them; settling one records your choice as a pending change." />

            <Grid ColumnDefinitions="320,4,*" IsVisible="{Binding HasConflicts}">

              <ListBox Grid.Column="0" ItemsSource="{Binding Conflicts}"
                       SelectedItem="{Binding SelectedConflict}"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConflictedFileViewModel">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,10,0"
                              Background="#18FFFFFF" CornerRadius="3">
                        <controls:LazyThumbnail DataContext="{Binding Item}"
                                                Source="{Binding Thumbnail}"
                                                Stretch="Uniform" Margin="2" />
                      </Border>
                      <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Folder}" Classes="hint"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#FF7043"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#22FFFFFF" />

              <ScrollViewer Grid.Column="2" Padding="16,10,16,16">
                <StackPanel Spacing="12" DataContext="{Binding SelectedConflict}"
                            x:DataType="vm:ConflictedFileViewModel">

                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="96" Height="96" Margin="0,0,14,0"
                            Background="#18FFFFFF" CornerRadius="3">
                      <controls:LazyThumbnail DataContext="{Binding Item}"
                                              Source="{Binding Thumbnail}"
                                              Stretch="Uniform" Margin="3" />
                    </Border>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Folder}" Classes="hint" />
                      <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#FF7043" />
                    </StackPanel>
                  </DockPanel>

                  <Grid ColumnDefinitions="110,*,*" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" Text="FIELD" Classes="column" />
                    <TextBlock Grid.Column="1" Text="IN THE FILE" Classes="column" />
                    <!--
                      Named as the one in use because that is the fact the decision turns on: the
                      sidecar is laid over the file's own values, so its side is what the inspector
                      shows, what search matches, and what "keep the sidecar" would preserve.
                    -->
                    <TextBlock Grid.Column="2" Text="IN THE SIDECAR — IN USE NOW" Classes="column"
                               Foreground="#5CB8F5" />
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Conflicts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:MetadataConflict">
                        <Border Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="#14FFFFFF">
                          <Grid ColumnDefinitions="110,*,*">
                            <TextBlock Grid.Column="0" Text="{Binding Field}" FontSize="12" Opacity="0.7" />
                            <TextBlock Grid.Column="1" Text="{Binding EmbeddedValue}" Classes="now" FontSize="12"
                                       Margin="0,0,12,0" Opacity="0.6" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{Binding SidecarValue}" Classes="now" FontSize="12"
                                       TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Settling is a decision, recorded as a pending change; writing is separate. -->
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Keep the file's values"
                            ToolTip.Tip="Take the left column. Fields the sidecar alone supplies are kept."
                            Command="{Binding $parent[Window].((vm:ChangesViewModel)DataContext).ResolveCommand}"
                            CommandParameter="KeepEmbedded" />
                    <Button Content="Keep the sidecar's values"
                            ToolTip.Tip="Take the right column, which is what you are seeing now. Nothing visibly changes; the disagreement is recorded as settled."
                            Command="{Binding $parent[Window].((vm:ChangesViewModel)DataContext).ResolveCommand}"
                            CommandParameter="KeepSidecar" />
                    <Button Content="Merge"
                            ToolTip.Tip="Union the keywords from both sides; for every other field the sidecar wins."
                            Command="{Binding $parent[Window].((vm:ChangesViewModel)DataContext).ResolveCommand}"
                            CommandParameter="Merge" />
                  </StackPanel>
                  <TextBlock Classes="hint"
                             Text="Whichever you choose becomes a pending change on the Changes tab; nothing is written until you write it. Writing updates the sidecar only — the copy inside the media file changes during Sync, so this file may keep showing a conflict until then." />

                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Panel>
        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
