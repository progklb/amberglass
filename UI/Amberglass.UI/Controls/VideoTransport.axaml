<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Amberglass.UI.ViewModels"
             xmlns:conv="using:Amberglass.UI.Converters"
             x:Class="Amberglass.UI.Controls.VideoTransport"
             x:DataType="vm:VideoPlayerViewModel">

  <!--
    The video controls, in one place so the inline preview and the fullscreen viewer cannot drift
    apart. The fullscreen button raises an event rather than acting, because what it should do
    depends on which of the two is hosting it.
  -->
  <Border DockPanel.Dock="Bottom" Padding="10,6" Background="#22000000">
    <StackPanel Spacing="6">

      <!-- Transport -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
        <!-- All three drawn on the same 24-unit grid, so they share a weight and a baseline. -->
        <Button Grid.Column="0" ToolTip.Tip="Previous frame"
                Padding="8,4" Command="{Binding StepBackCommand}">
          <PathIcon Width="13" Height="13"
                    Data="{x:Static conv:TransportGlyphs.StepBack}" />
        </Button>
        <Button Grid.Column="1" Margin="4,0" ToolTip.Tip="Play / pause (Space)"
                Padding="10,4" Command="{Binding TogglePlayCommand}">
          <PathIcon Width="13" Height="13"
                    Data="{Binding IsPlaying, Converter={StaticResource PlayGlyph}}" />
        </Button>
        <Button Grid.Column="2" ToolTip.Tip="Next frame"
                Padding="8,4" Command="{Binding StepForwardCommand}">
          <PathIcon Width="13" Height="13"
                    Data="{x:Static conv:TransportGlyphs.StepForward}" />
        </Button>

        <!--
          Volume. Disabled rather than hidden for a silent file, so the control stays
          where the eye expects it and its tooltip can explain why nothing happens.
        -->
        <Button Grid.Column="3" Margin="8,0,0,0" Padding="8,2"
                IsEnabled="{Binding CanPlayAudio}"
                ToolTip.Tip="{Binding VolumeDisplay}">
          <PathIcon Width="14" Height="14"
                    Data="{Binding IsMuted, Converter={StaticResource VolumeGlyph}}" />
          <Button.Flyout>
            <Flyout Placement="Top">
              <StackPanel Width="190" Spacing="6" Margin="4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Volume" FontSize="11"
                             VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                             FontSize="11" Opacity="0.5" VerticalAlignment="Center"
                             Text="{Binding VolumeDisplay}" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleButton Padding="6,2" IsChecked="{Binding IsMuted}"
                                ToolTip.Tip="Mute">
                    <PathIcon Width="12" Height="12"
                              Data="{Binding IsMuted, Converter={StaticResource VolumeGlyph}}" />
                  </ToggleButton>
                  <Slider Width="120" Minimum="0" Maximum="1"
                          Value="{Binding Volume}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="12,0,8,0"
                   FontSize="12" FontFamily="monospace"
                   Text="{Binding PositionDisplay}" />

        <Slider Grid.Column="5" VerticalAlignment="Center"
                Minimum="0" Maximum="{Binding DurationSeconds}"
                Value="{Binding PositionSeconds}" />

        <TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="8,0,12,0"
                   FontSize="12" FontFamily="monospace" Opacity="0.7"
                   Text="{Binding DurationDisplay}" />

        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Padding="8,2" Click="OnFullscreenRequested"
                  ToolTip.Tip="Fullscreen (F)">
            <!-- Four corner brackets: the conventional "expand to fill" mark. -->
            <PathIcon Width="13" Height="13"
                      Data="M3 3h7v2H5v5H3V3zm11 0h7v7h-2V5h-5V3zM3 14h2v5h5v2H3v-7zm16 0h2v7h-7v-2h5v-5z" />
          </Button>
          <TextBlock Text="Quality" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
          <ComboBox ItemsSource="{Binding QualityChoices}"
                    SelectedIndex="{Binding SelectedQualityIndex}"
                    MinWidth="98"
                    ToolTip.Tip="Lower qualities play from a cached proxy. The original file is never modified." />
        </StackPanel>
      </Grid>

      <!-- Proxy generation / status -->
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Opacity="0.6"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Width="120" Height="3" VerticalAlignment="Center"
                     Minimum="0" Maximum="1" Value="{Binding ProxyProgress}"
                     IsVisible="{Binding IsPreparing}" />
      </Grid>
    </StackPanel>
  </Border>

</UserControl>
