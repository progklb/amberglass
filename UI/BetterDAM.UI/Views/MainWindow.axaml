<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BetterDAM.UI.ViewModels"
        xmlns:controls="using:BetterDAM.UI.Controls"
        xmlns:views="using:BetterDAM.UI.Views"
        xmlns:svc="using:BetterDAM.UI.Services"
        xmlns:search="using:BetterDAM.Core.Services"
        mc:Ignorable="d"
        x:Class="BetterDAM.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600"
        Classes.handDrawn="{DynamicResource AppRingEnabled}"
        Classes.contactSheet="{DynamicResource AppContactSheet}">

  <Window.KeyBindings>
    <KeyBinding Gesture="{x:Static svc:MenuConventions.ToggleFolderPanel}"
                Command="{Binding ToggleFolderPanelCommand}" />
  </Window.KeyBindings>

  <!--
    F for fullscreen, handled in code-behind rather than as a KeyBinding so it can be ignored while
    a text box has focus - otherwise typing "f" into the search box would open the viewer.
  -->

  <Window.Styles>
    <!-- A button that reads as text until the pointer finds it. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14FFFFFF" />
    </Style>
    <Style Selector="TreeViewItem" x:DataType="vm:FolderNodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Margin" Value="0,10,0,2" />
    </Style>
    <!--
      Section headers in the filter popup that open and shut. A plain Button rather than a
      ToggleButton: the triangle already says which way it is, and a ToggleButton would paint an
      accent block behind the header to say it again.
    -->
    <Style Selector="Button.disclosure">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <!--
        The padding keeps the text off the edge of the hover band; the negative margin of the same
        size puts the band back where it was, so the header still lines up with the rows above it.
      -->
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="-6,0" />
      <!--
        Both, and for different reasons: Stretch makes the whole row a hit area, and stretching the
        content is what lets anything docked right actually reach the right edge.
      -->
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Stars in the filter popup: a glyph and a hit area, with none of a button's chrome. -->
    <Style Selector="Button.star">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <!--
      The dividers beside the two side panels. A line while it divides two things; once the panel
      beside it is shut there is nothing to divide, so it stops drawing itself and leaves only the
      small handle in the middle of the edge. The strip is still there to drag, and still Transparent
      rather than unset, which is what keeps it hit-testable.
    -->
    <Style Selector="GridSplitter.panel">
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
    <Style Selector="GridSplitter.panel.collapsed">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="GridSplitter.panel.collapsed:pointerover">
      <Setter Property="Background" Value="#14FFFFFF" />
    </Style>

    <!-- The pull itself. Not hit-testable, so the whole strip behind it stays one thing to drag. -->
    <Style Selector="Border.grabHandle">
      <Setter Property="Background" Value="#59FFFFFF" />
      <Setter Property="Width" Value="4" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </Window.Styles>

  <!--
    Window-scoped menu. macOS exports this to the system menu bar; elsewhere the NativeMenuBar below
    draws it inside the window.
  -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <!--
              Click rather than Command: NativeMenuItem has no DataContext, so a {Binding} here
              silently resolves to null and the item does nothing.
            -->
            <NativeMenuItem Header="Open Folder…"
                            Gesture="{x:Static svc:MenuConventions.OpenFolder}"
                            Click="OnOpenFolder" />
            <!-- Contents rebuilt in code from RecentWorkspaces; see MainWindow.RebuildRecentMenu. -->
            <NativeMenuItem Header="{x:Static svc:MenuConventions.OpenRecentHeader}">
              <NativeMenuItem.Menu>
                <NativeMenu />
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItemSeparator IsVisible="{x:Static svc:MenuConventions.ShowSettingsInFileMenu}" />
            <NativeMenuItem Header="Settings…"
                            IsVisible="{x:Static svc:MenuConventions.ShowSettingsInFileMenu}"
                            Gesture="{x:Static svc:MenuConventions.Settings}"
                            Click="OnOpenSettings" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>

      <!--
        Everything that acts on the open workspace. Hidden until one is open, from code — a
        NativeMenuItem has no DataContext, so its visibility cannot be bound; see
        MainWindow.UpdateWorkspaceMenu.
      -->
      <NativeMenuItem Header="{x:Static svc:MenuConventions.WorkspaceHeader}" IsVisible="False">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Prepare Workspace…" Click="OnPrepareWorkspace" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Close Workspace"
                            Gesture="{x:Static svc:MenuConventions.CloseWorkspace}"
                            Click="OnCloseWorkspace" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <DockPanel>

    <!-- Renders the menu in-window on platforms without a system menu bar; nothing on macOS. -->
    <NativeMenuBar DockPanel.Dock="Top" />

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF">
      <!--
        The top bar is search and nothing else. Controls that act on a specific panel now live in
        that panel: Recursive with the folders, thumbnail size with the thumbnails.
      -->
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Left" Content="☰" Padding="10,4" Margin="0,0,10,0"
                Command="{Binding ToggleFolderPanelCommand}"
                ToolTip.Tip="Show or hide the folders panel (⌘B)" />

        <!--
          View options. A flyout rather than a strip in the thumbnail panel: it costs no permanent
          space, and it is the place to put the display controls that follow (sort order, what the
          tiles show) without each one having to find room in the chrome.
        -->
        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4"
                ToolTip.Tip="View options">
          <!-- Three slider tracks with knobs at different positions: "adjust how this looks". -->
          <PathIcon Width="14" Height="14"
                    Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="230" Spacing="6" Margin="4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Thumbnail size"
                             FontSize="11" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                             FontSize="11" Opacity="0.5" VerticalAlignment="Center"
                             Text="{Binding ThumbnailSize, StringFormat='{}{0:F0} px'}" />
                </DockPanel>
                <Slider Minimum="90" Maximum="320" Value="{Binding ThumbnailSize}" />

                <CheckBox Content="Filmstrip" FontSize="11"
                          IsChecked="{Binding Filmstrip}"
                          ToolTip.Tip="One row of thumbnails with the preview filling the rest. Dragging the divider to the bottom does the same thing (E)." />
                <TextBlock Classes="hint" IsVisible="{Binding Filmstrip}"
                           Text="The thumbnail size still sets how tall the strip is." />

                <CheckBox Content="Preview above thumbnails" FontSize="11"
                          IsChecked="{Binding PreviewOnTop}"
                          ToolTip.Tip="Puts the picture at the top of the window with the thumbnails along the bottom, the way most editing applications are laid out" />

                <Separator Margin="0,4" />

                <CheckBox Content="Folders panel" FontSize="11"
                          IsChecked="{Binding IsFolderPanelVisible}"
                          ToolTip.Tip="Show or hide the folder tree (⌘B). Dragging its divider shut does the same thing." />
                <CheckBox Content="Metadata panel" FontSize="11"
                          IsChecked="{Binding IsInspectorVisible}"
                          ToolTip.Tip="Show or hide the panel on the right. Dragging its divider shut does the same thing." />

                <Separator Margin="0,4" />

                <TextBlock Text="RAW files" FontSize="11" />
                <StackPanel Spacing="2">
                  <RadioButton GroupName="RawMode" FontSize="11"
                               Content="Develop the RAW"
                               IsChecked="{Binding DevelopRawFiles}"
                               ToolTip.Tip="Demosaics the sensor data: more pixels and no in-camera processing, but takes a few seconds" />
                  <RadioButton GroupName="RawMode" FontSize="11"
                               Content="Embedded JPEG"
                               IsChecked="{Binding !DevelopRawFiles}"
                               ToolTip.Tip="The preview the camera wrote alongside the RAW - instant, but smaller and already processed" />
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding DevelopRawFiles}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="RAW quality" FontSize="11" VerticalAlignment="Center" />
                    <ComboBox DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="106" FontSize="11"
                              ItemsSource="{Binding RawQualities}"
                              SelectedItem="{Binding RawQuality}"
                              ToolTip.Tip="Fast is for a first pass through a folder; Best is for judging a frame. It is the difference between roughly instant and several seconds an image." />
                  </DockPanel>
                </StackPanel>

                <Separator Margin="0,4" />

                <CheckBox Content="Stack RAW + JPEG pairs" FontSize="11"
                          IsChecked="{Binding StackPairs}"
                          ToolTip.Tip="Files with the same name in the same folder are one photograph, and are drawn as one tile" />

                <StackPanel Spacing="2" Margin="24,0,0,0" IsVisible="{Binding StackPairs}">
                  <RadioButton GroupName="StackShows" FontSize="11"
                               Content="Show the RAW"
                               IsChecked="{Binding ShowsRaw}"
                               ToolTip.Tip="The negative — the file your edits belong to" />
                  <RadioButton GroupName="StackShows" FontSize="11"
                               Content="Show the JPEG"
                               IsChecked="{Binding !ShowsRaw}"
                               ToolTip.Tip="The camera's own rendering — quicker to draw, and often quicker to judge" />
                </StackPanel>

                <TextBlock Classes="hint" FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                           IsVisible="{Binding StackPairs}"
                           Text="Only what is drawn changes. Both files are still found by search, still written to, and still counted." />

                <Separator Margin="0,4" />

                <TextBlock Text="Open viewer as" FontSize="11" />
                <StackPanel Spacing="2">
                  <RadioButton GroupName="ViewerMode" FontSize="11"
                               Content="Maximised window"
                               IsChecked="{Binding !ViewerOpensFullscreen}"
                               ToolTip.Tip="Fills the current screen and stays on this desktop" />
                  <RadioButton GroupName="ViewerMode" FontSize="11"
                               Content="Fullscreen"
                               IsChecked="{Binding ViewerOpensFullscreen}"
                               ToolTip.Tip="Hides the menu bar, but macOS gives it a Space of its own" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!--
          Filters. The syntax was previously discoverable only from a tooltip, which is to say not
          at all — this is where it is written down, alongside the one setting that changes what a
          search means.
        -->
        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4"
                IsVisible="{Binding HasWorkspace}"
                ToolTip.Tip="How to filter, and where to search">
          <Panel>
            <!-- Funnel: wide mouth, converging neck, stem down the middle. -->
            <PathIcon Width="13" Height="13"
                      Data="M2 4 H22 L14 13 V20 L10 18 V13 Z" />
            <!--
              The scope now lives inside the popup, so the button has to carry some sign of it —
              otherwise "search everywhere" would be on with nothing on screen saying so.
            -->
            <Ellipse Width="5" Height="5" Margin="0,0,-3,-3"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Fill="{DynamicResource SystemAccentColorLight1}"
                     IsVisible="{Binding SearchEverywhere}" />
          </Panel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" Opened="OnFilterFlyoutOpened">
              <StackPanel Width="330" Spacing="10" Margin="4">

                <TextBlock Text="Filters" FontSize="13" FontWeight="SemiBold" />

                <!--
                  These write into the search box rather than holding a filter state of their own, so
                  there is one query, it is visible, and clicking three stars shows what to type next
                  time. Reading works the other way too: a typed r:>=3 lights three stars.
                -->
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Rating" FontSize="11"
                             VerticalAlignment="Center" Width="52" />
                  <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Left">
                    <Button Classes="star" Command="{Binding SetRatingFilterCommand}" CommandParameter="1">
                      <Button.Content>
                        <MultiBinding Converter="{StaticResource FilterStarGlyph}" ConverterParameter="1">
                          <Binding Path="FilterRating" />
                          <Binding Path="FilterRatingExact" />
                        </MultiBinding>
                      </Button.Content>
                    </Button>
                    <Button Classes="star" Command="{Binding SetRatingFilterCommand}" CommandParameter="2">
                      <Button.Content>
                        <MultiBinding Converter="{StaticResource FilterStarGlyph}" ConverterParameter="2">
                          <Binding Path="FilterRating" />
                          <Binding Path="FilterRatingExact" />
                        </MultiBinding>
                      </Button.Content>
                    </Button>
                    <Button Classes="star" Command="{Binding SetRatingFilterCommand}" CommandParameter="3">
                      <Button.Content>
                        <MultiBinding Converter="{StaticResource FilterStarGlyph}" ConverterParameter="3">
                          <Binding Path="FilterRating" />
                          <Binding Path="FilterRatingExact" />
                        </MultiBinding>
                      </Button.Content>
                    </Button>
                    <Button Classes="star" Command="{Binding SetRatingFilterCommand}" CommandParameter="4">
                      <Button.Content>
                        <MultiBinding Converter="{StaticResource FilterStarGlyph}" ConverterParameter="4">
                          <Binding Path="FilterRating" />
                          <Binding Path="FilterRatingExact" />
                        </MultiBinding>
                      </Button.Content>
                    </Button>
                    <Button Classes="star" Command="{Binding SetRatingFilterCommand}" CommandParameter="5">
                      <Button.Content>
                        <MultiBinding Converter="{StaticResource FilterStarGlyph}" ConverterParameter="5">
                          <Binding Path="FilterRating" />
                          <Binding Path="FilterRatingExact" />
                        </MultiBinding>
                      </Button.Content>
                    </Button>
                    <TextBlock FontSize="10" Opacity="0.45" VerticalAlignment="Center" Margin="6,0,0,0"
                               Text="{Binding RatingFilterSummary}" />
                  </StackPanel>
                </DockPanel>

                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Show" FontSize="11"
                             VerticalAlignment="Center" Width="52" />
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                    <ToggleButton Content="RAW" FontSize="11" Padding="9,3" IsChecked="{Binding FilterRaw}" />
                    <ToggleButton Content="JPEG" FontSize="11" Padding="9,3" IsChecked="{Binding FilterJpeg}"
                                  ToolTip.Tip="Any image that is not a RAW — JPEG, PNG, HEIC" />
                    <ToggleButton Content="Video" FontSize="11" Padding="9,3" IsChecked="{Binding FilterVideo}" />
                  </StackPanel>
                </DockPanel>

                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Flag" FontSize="11"
                             VerticalAlignment="Center" Width="52" />
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                    <ToggleButton Content="✓ Keep" FontSize="11" Padding="9,3"
                                  IsChecked="{Binding FilterAccepted}" />
                    <ToggleButton Content="✕ Reject" FontSize="11" Padding="9,3"
                                  IsChecked="{Binding FilterRejected}" />
                    <ToggleButton Content="Unflagged" FontSize="11" Padding="9,3"
                                  IsChecked="{Binding FilterUnflagged}"
                                  ToolTip.Tip="Not yet judged — what is left to look at" />
                  </StackPanel>
                </DockPanel>

                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Label" FontSize="11"
                             VerticalAlignment="Center" Width="52" />
                  <!--
                    Built from the library rather than written out here: the labels are the user's,
                    and there may be any number of them under any names.
                  -->
                  <ItemsControl ItemsSource="{Binding LabelChips}" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LabelFilterChip">
                        <ToggleButton Margin="0,0,6,4" Padding="7,3" FontSize="11"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding ToggleCommand}"
                                      ToolTip.Tip="{Binding Name}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{Binding Colour}"
                                    IsVisible="{Binding HasColour}" />
                            <!-- No label gets an outline where the others get a colour. -->
                            <Border Width="10" Height="10" CornerRadius="2"
                                    VerticalAlignment="Center"
                                    BorderBrush="#66FFFFFF" BorderThickness="1"
                                    IsVisible="{Binding !HasColour}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                          </StackPanel>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>

                <!--
                  Keywords. The only filter that needs a list rather than a row of toggles: there
                  may be hundreds, so it is searchable, and each one carries the number of files that
                  have it — a filter that will find nothing says so before it is applied.
                -->
                <StackPanel Spacing="5">
                  <Button Classes="disclosure" Command="{Binding ToggleKeywordListCommand}"
                          ToolTip.Tip="Show the keywords found in this workspace">
                    <DockPanel>
                      <!-- Filled triangles rather than a glyph, so a handwriting font cannot lose them. -->
                      <PathIcon DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,6,0"
                                Data="M 3 2 L 8 6 L 3 10 Z"
                                IsVisible="{Binding !KeywordListExpanded}" />
                      <PathIcon DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,6,0"
                                Data="M 2 3 L 10 3 L 6 8 Z"
                                IsVisible="{Binding KeywordListExpanded}" />
                      <TextBlock DockPanel.Dock="Left" Text="{Binding KeywordHeaderText}"
                                 FontSize="11" VerticalAlignment="Center" />
                      <!--
                        With two words ticked, "any" and "all" are both reasonable readings and
                        return very different sets, so the panel asks rather than guesses. Only
                        while the list is open: shut, there is nothing on screen it applies to.
                      -->
                      <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0"
                                  HorizontalAlignment="Right"
                                  IsVisible="{Binding KeywordListExpanded}">
                        <RadioButton GroupName="KeywordMatch" FontSize="11" Content="any"
                                     IsChecked="{Binding !KeywordFilterMatchAll}"
                                     ToolTip.Tip="Files with at least one of the ticked keywords" />
                        <RadioButton GroupName="KeywordMatch" FontSize="11" Content="all"
                                     IsChecked="{Binding KeywordFilterMatchAll}"
                                     ToolTip.Tip="Files carrying every ticked keyword" />
                      </StackPanel>
                    </DockPanel>
                  </Button>

                  <TextBox Classes="compact" FontSize="11" Watermark="Find a keyword"
                           Text="{Binding KeywordFilterSearch}" />

                  <!--
                    Shut over a filter that is running, the section would misrepresent the query — so
                    what is ticked stays on show, as the same pills the inspector gives a keyword.
                  -->
                  <Grid RowDefinitions="Auto,Auto" IsVisible="{Binding ShowKeywordSummary}">
                    <!--
                      A DockPanel, not a horizontal StackPanel: a StackPanel measures its children
                      against infinite width, so the WrapPanel inside would never find an edge to
                      wrap at and the pills ran off the side of the panel.
                    -->
                    <DockPanel Grid.Row="0">
                      <TextBlock DockPanel.Dock="Left" FontSize="11" Opacity="0.55" Margin="0,4,6,0"
                                 VerticalAlignment="Top"
                                 IsVisible="{Binding ShowKeywordFilterMode}"
                                 Text="{Binding KeywordFilterMode}" />

                      <ItemsControl ItemsSource="{Binding SelectedKeywordPills}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:KeywordFilterPill">
                          <Border Background="#28FFFFFF" CornerRadius="10" Padding="8,2"
                                  Margin="0,0,4,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}" FontSize="11"
                                         VerticalAlignment="Center" />
                              <Button Content="✕" FontSize="9" Padding="2,0" MinWidth="0"
                                      Background="Transparent" BorderThickness="0"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Drop this keyword from the filter"
                                      Command="{Binding RemoveCommand}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DockPanel>

                    <!-- Its own line, so it cannot be what pushes the pills off the edge. -->
                    <TextBlock Grid.Row="1" FontSize="11" Opacity="0.55" Margin="0,0,0,4"
                               IsVisible="{Binding HasKeywordPillOverflow}"
                               Text="{Binding KeywordPillOverflow}" />
                  </Grid>

                  <Border BorderThickness="1" CornerRadius="3" MaxHeight="150"
                          IsVisible="{Binding KeywordListExpanded}"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Panel>
                      <TextBlock Margin="8,10" FontSize="11" Opacity="0.45"
                                 Text="{Binding KeywordFilterEmptyText}"
                                 IsVisible="{Binding !HasKeywordChips}" />
                      <ScrollViewer VerticalScrollBarVisibility="Auto"
                                    IsVisible="{Binding HasKeywordChips}">
                        <ItemsControl ItemsSource="{Binding KeywordChips}" Margin="4">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeywordFilterChip">
                              <CheckBox Padding="6,0,0,0" MinHeight="0" Margin="2,1"
                                        HorizontalAlignment="Stretch"
                                        IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        Command="{Binding ToggleCommand}">
                                <DockPanel>
                                  <TextBlock DockPanel.Dock="Right" FontSize="10" Opacity="0.45"
                                             Margin="8,0,0,0" VerticalAlignment="Center"
                                             Text="{Binding CountDisplay}" />
                                  <TextBlock FontSize="11" VerticalAlignment="Center"
                                             TextTrimming="CharacterEllipsis"
                                             Text="{Binding Name}" />
                                </DockPanel>
                              </CheckBox>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Panel>
                  </Border>
                </StackPanel>

                <Separator />

                <TextBlock Text="Where to search" FontSize="12" FontWeight="SemiBold" />
                <StackPanel Spacing="2">
                  <RadioButton GroupName="SearchScope" FontSize="11"
                               Content="{Binding WorkspaceName, StringFormat='Just {0}'}"
                               IsChecked="{Binding !SearchEverywhere}" />
                  <RadioButton GroupName="SearchScope" FontSize="11"
                               Content="Everything indexed"
                               IsChecked="{Binding SearchEverywhere}"
                               ToolTip.Tip="Every workspace that has been indexed, not only the open one" />
                </StackPanel>

                <Separator />

                <!--
                  The syntax reference is worth having and worth finding, but it was the tallest
                  thing in the panel and it is a reference — read once, not every time the filters
                  are opened.
                -->
                <Button Classes="disclosure" Command="{Binding ToggleSearchHelpCommand}">
                  <DockPanel>
                    <PathIcon DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,6,0"
                              Data="M 3 2 L 8 6 L 3 10 Z"
                              IsVisible="{Binding !SearchHelpExpanded}" />
                    <PathIcon DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,6,0"
                              Data="M 2 3 L 10 3 L 6 8 Z"
                              IsVisible="{Binding SearchHelpExpanded}" />
                    <TextBlock Text="How to search" FontSize="12" FontWeight="SemiBold" />
                  </DockPanel>
                </Button>

                <StackPanel Spacing="10" IsVisible="{Binding SearchHelpExpanded}">
                  <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                             Text="Type a field and a colon; the short form does the same thing. Different fields narrow together, so rating, keywords and type can all apply at once." />

                  <ItemsControl ItemsSource="{Binding SearchHelp}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="search:SearchField">
                        <Grid ColumnDefinitions="52,*" Margin="0,3">
                          <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                     Text="{Binding Short, StringFormat='{}{0}:'}" />
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock FontSize="11" Text="{Binding Summary}" />
                            <TextBlock FontSize="10" Opacity="0.45" Text="{Binding Example}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock FontSize="10" Opacity="0.45" TextWrapping="Wrap"
                             Text="Repeat a field to ask for all of them — k:sand k:dust. Use commas to ask for any of them — k:sand,dust. Typing a colon on its own brings this list up in the box." />
                </StackPanel>

              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!--
          The suggestion list is a Popup anchored to the box rather than a flyout, so the box keeps
          focus and the user carries on typing through it.
        -->
        <Panel>
        <Popup PlacementTarget="{Binding #SearchBox}" Placement="BottomEdgeAlignedLeft"
               IsOpen="{Binding HasFieldSuggestions}" IsLightDismissEnabled="False">
          <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="#33FFFFFF"
                  BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,2,0,0">
            <ListBox x:Name="SuggestionList" Width="300" MaxHeight="230"
                     Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding FieldSuggestions}"
                     SelectedIndex="{Binding SelectedSuggestionIndex}"
                     PointerReleased="OnSuggestionClicked">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchSuggestionItem">
                  <Grid ColumnDefinitions="58,*" Margin="0,1">
                    <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Opacity="0.7"
                               Text="{Binding Lead}" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock FontSize="11" Text="{Binding Text}" />
                      <TextBlock FontSize="10" Opacity="0.45" Text="{Binding Detail}"
                                 IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Popup>

        <!--
          Vertical padding zeroed and the content centred instead. The theme's default padding is
          asymmetric top to bottom, which left the text and caret sitting slightly high in a box
          this tall; centring puts them on the same line as the icon beside them.
        -->
        <TextBox x:Name="SearchBox"
                 Text="{Binding SearchText}"
                 Watermark="{Binding SearchWatermark}"
                 HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Center"
                 Padding="2,0"
                 ToolTip.Tip="Words search titles, descriptions, keywords and creators. Type a colon to see the filters.">
          <TextBox.InnerLeftContent>
            <!--
              Magnifier: the ring, the same ring again smaller to punch the lens out of it, then
              the handle. A PathIcon rather than the 🔍 emoji, which came from the system emoji
              font and so carried its own weight and colour — the one icon in the window that did
              not match the rest.
            -->
            <PathIcon Width="13" Height="13" Margin="8,0,4,0" Opacity="0.6"
                      VerticalAlignment="Center"
                      Data="M10 3 A7 7 0 1 0 10 17 A7 7 0 1 0 10 3 Z
                            M10 5 A5 5 0 1 1 10 15 A5 5 0 1 1 10 5 Z
                            M15 16.4 L16.4 15 L21.3 19.9 L19.9 21.3 Z" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Content="✕" Padding="8,2" Margin="0,0,4,0" Background="Transparent"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Clear the search and go back to the folder"
                    IsVisible="{Binding IsShowingSearchResults}"
                    Command="{Binding ClearSearchCommand}" />
          </TextBox.InnerRightContent>
          <!--
            Enter is not a KeyBinding any more: while the field list is open it has to accept the
            highlighted field instead of running the search, and a KeyBinding cannot be conditional.
            See OnSearchKeyDown.
          -->
        </TextBox>
        </Panel>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF">
      <DockPanel>
        <!-- Pending changes are the heart of the workflow, so the count is always in view. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                    IsVisible="{Binding HasPendingChanges}">
          <!--
            The count is the way into the review, the way a status line's count is what you click
            to see the changes themselves. A button dressed as text rather than one more button:
            the bar already has three.
          -->
          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding !IsConfirmingBulkAction}">
            <Button Classes="link" VerticalAlignment="Center" Click="OnOpenChanges"
                    ToolTip.Tip="Review each change, before and after, and write or discard them a file at a time">
              <TextBlock Foreground="#5CB8F5"
                         Text="{Binding PendingChangeCount, StringFormat='● {0} file(s) with pending changes'}" />
            </Button>
            <Button Content="Write all sidecars…" FontSize="11" Padding="8,2"
                    ToolTip.Tip="Write every pending change to its XMP sidecar. Original media is not modified."
                    IsEnabled="{Binding !IsWritingAll}"
                    Command="{Binding BeginWriteAllCommand}" />
            <Button Content="Sync…" FontSize="11" Padding="8,2" Click="OnOpenSync"
                    ToolTip.Tip="Review and commit pending changes, optionally embedding them into the originals" />
            <Button Content="Discard all…" FontSize="11" Padding="8,2"
                    Command="{Binding BeginDiscardAllCommand}" />
          </StackPanel>

          <!--
            Asked where the button was, as the destructive actions in Settings are. Both of these
            act on every pending change at once and sit beside the count, which is the one thing in
            this bar that invites a click — so either is a plausible miss, and discarding cannot be
            undone.
          -->
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingWriteAll}">
            <TextBlock Text="{Binding WriteAllPrompt}" VerticalAlignment="Center" FontSize="11" />
            <Button Content="Write" FontSize="11" Padding="8,2"
                    Command="{Binding WriteAllPendingSidecarsCommand}" />
            <Button Content="Cancel" FontSize="11" Padding="8,2"
                    Command="{Binding CancelBulkActionCommand}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingDiscardAll}">
            <TextBlock Text="{Binding DiscardAllPrompt}" VerticalAlignment="Center" FontSize="11" />
            <Button Content="Discard" FontSize="11" Padding="8,2"
                    Background="#33FF6B6B" BorderBrush="#66FF6B6B"
                    Command="{Binding DiscardAllPendingChangesCommand}" />
            <Button Content="Keep" FontSize="11" Padding="8,2"
                    Command="{Binding CancelBulkActionCommand}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ProgressBar IsIndeterminate="True" Width="90" Height="4"
                       VerticalAlignment="Center" IsVisible="{Binding IsScanning}" />
          <Button Content="Cancel scan" FontSize="11" Padding="8,2"
                  IsVisible="{Binding IsScanning}"
                  Command="{Binding CancelScanCommand}" />
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />

          <!--
            The footnote to that count, and only when there is one to make: it counts files, and
            the grid is of photographs. Reading "205 match(es)" over a hundred-odd tiles is a
            discrepancy the user would otherwise have to work out for themselves.
          -->
          <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.55"
                     IsVisible="{Binding HasStackedAway}"
                     Text="{Binding StackedAwayCount, StringFormat='◫ {0} stacked'}"
                     ToolTip.Tip="Files drawn behind another because they are the same photograph. They are still searched, still written to, and still counted." />

          <!-- Indexing runs behind browsing, so it reports quietly rather than blocking. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding IsIndexing}">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding IndexProgress}"
                         Width="80" Height="4" VerticalAlignment="Center" />
            <TextBlock Text="{Binding IndexStatus}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
            <Button Content="Stop" FontSize="10" Padding="6,1" Command="{Binding CancelIndexingCommand}" />
          </StackPanel>

          <!-- The way back after declining, so "Not now" is not a one-way door. -->
          <Button Content="Index workspace" FontSize="11" Padding="8,2"
                  IsVisible="{Binding CanIndexWorkspace}"
                  Command="{Binding IndexWorkspaceCommand}"
                  ToolTip.Tip="Read metadata for every file in this workspace so it can be searched" />

          <TextBlock Text="{Binding SearchWarning}" FontSize="11" Foreground="#FFC107"
                     VerticalAlignment="Center"
                     IsVisible="{Binding SearchWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!--
      Named so the code-behind can reach the column definitions, which it owns: the splitters write
      to these widths as they are dragged, and a binding would be fighting them for it. The widths
      here are only what the designer shows; the real ones are the remembered layout, applied as the
      window opens.
    -->
    <Grid x:Name="LayoutColumns">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="0" />
        <!-- Wide enough for a line, or for a film edge: see AppThemes.SplitterWidthFor. -->
        <ColumnDefinition Width="{DynamicResource AppSplitterWidth}" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="{DynamicResource AppSplitterWidth}" />
        <ColumnDefinition Width="360" MinWidth="0" />
      </Grid.ColumnDefinitions>


      <!-- Folders panel: the tree plus the one option that only affects it. -->
      <DockPanel Grid.Column="0" IsVisible="{Binding IsFolderPanelVisible}">
        <Border DockPanel.Dock="Bottom" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF">
          <CheckBox Content="Include subfolders" FontSize="11"
                    IsChecked="{Binding Recursive}"
                    ToolTip.Tip="Show media from every folder beneath the selected one" />
        </Border>

        <TreeView ItemsSource="{Binding FolderRoots}"
                  SelectedItem="{Binding SelectedFolder}"
                  Classes.handDrawn="{DynamicResource AppRingEnabled}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:FolderNodeViewModel">
              <!--
                The ring is given room by padding the name rather than by growing outside the row,
                which the header presenter would clip. The padding is small enough to pass for
                ordinary breathing space when the experiment is switched off.
              -->
              <!--
                Left-aligned, and this matters: the header presenter stretches to the full width of
                the panel, so a panel that filled it drew one wide thin oval across the whole row
                whatever the folder was called. Hugging the name is what makes the ring fit it.
              -->
              <!--
                A transparent border across the full row so right-clicking anywhere on it reaches
                the folder, not only the few characters of its name. The name panel inside keeps
                hugging the text, which is what the ring needs.
              -->
              <Border Background="Transparent" ContextRequested="OnFolderContextRequested">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{x:Static svc:RevealInFileManager.OpenFolderMenuHeader}"
                              Click="OnOpenFolderInFileManager" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Panel HorizontalAlignment="Left">
                  <controls:RoughMark IsSelected="{Binding $parent[TreeViewItem].IsSelected}"
                                      IsHovered="{Binding $parent[TreeViewItem].IsPointerOver}" />
                  <TextBlock Text="{Binding Name}" Margin="10,3" />
                </Panel>
              </Border>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>

      <!--
        The divider, and the way back when the panel is closed.

        Dragging a panel shut leaves nothing to take hold of, so the divider widens into a tab with
        an arrow on it pointing at the panel that is gone. The arrow is painted under the splitter
        and is not hit-testable, so the whole tab is still one thing to drag; letting go without
        moving opens the panel to the width it had.
      -->
      <!--
        Both of these sit in the divider's own column, drawn one over the other. Not wrapped in a
        panel together, which would be tidier to read: a GridSplitter finds the columns it resizes
        by looking at the Grid it is a child of, and one child of something else resizes nothing.

        The handle is the whole of what a shut panel leaves behind: a short bar at the middle of the
        edge, where a drawer pull would be. The point of shutting a panel is to be rid of it, and a
        full-height strip down the side of the window is not rid of it.
      -->
      <Border Grid.Column="1" Classes="grabHandle"
              IsVisible="{Binding !IsFolderPanelVisible}" />

      <GridSplitter x:Name="FolderSplitter" Grid.Column="1" Classes="panel"
                    Classes.collapsed="{Binding !IsFolderPanelVisible}"
                    ResizeDirection="Columns"
                    DragStarted="OnPanelSplitterDragStarted"
                    DragCompleted="OnFolderSplitterDragged"
                    ToolTip.Tip="Drag to resize the folders panel, or click to put it away. Click again to bring it back." />

      <!-- Thumbnail grid over preview -->
      <!--
        Named so the code-behind can reach the row definitions. x:Name on a RowDefinition would not
        do: inside a property element it generates no field.
      -->
      <Grid Grid.Column="2" x:Name="ContentRows">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <!--
            Which of these two carries the star is the whole of the filmstrip: the thumbnails take
            the space in a grid, the preview takes it in a filmstrip. Named so the code-behind can
            swap them, because the splitter writes to them too and a binding would fight it.
          -->
          <RowDefinition Height="*" MinHeight="0" />
          <RowDefinition Height="{DynamicResource AppSplitterWidth}" />
          <RowDefinition Height="280" MinHeight="0" />
        </Grid.RowDefinitions>

        <!--
          Non-modal by design: indexing a large workspace is offered, not demanded, and browsing
          carries on regardless of whether the question is ever answered.
        -->
        <Border Grid.Row="0"
                IsVisible="{Binding ShowIndexPrompt}"
                Background="#1E3A5F" BorderBrush="#2E5C8A" BorderThickness="0,0,0,1" Padding="12,10">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
              <Button Content="Index" Command="{Binding AcceptIndexPromptCommand}" />
              <Button Content="Not now" Command="{Binding DeclineIndexPromptCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding IndexPromptText}" TextWrapping="Wrap"
                       VerticalAlignment="Center" FontSize="12" />
          </DockPanel>
        </Border>

        <!--
          One surface for the whole thumbnail region. View controls live in the toolbar's View
          flyout rather than in a strip here: a strip docked above the splitter competed with it
          for space and had to be kept clear of it by hand.
        -->
        <Panel x:Name="ThumbnailPane" Grid.Row="1" Background="{DynamicResource AppPanelBrush}">

        <!--
          Sits in the same cell as the grid, after it so it draws on top. IsHitTestVisible is left
          on so the button works, but the panel only exists while the grid is empty.
        -->
        <Panel IsVisible="{Binding ShowEmptyState}" ZIndex="1">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      MaxWidth="380" Spacing="10">
            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="16" Opacity="0.85"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyStateDetail}" FontSize="12" Opacity="0.55"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <Button Content="Open Folder…" HorizontalAlignment="Center" Margin="0,4,0,0"
                    IsVisible="{Binding ShowEmptyStateAction}"
                    Command="{Binding OpenFolderCommand}" />
          </StackPanel>
        </Panel>

        <ListBox x:Name="ThumbnailGrid"
                 Background="Transparent"
                 Classes.handDrawn="{DynamicResource AppRingEnabled}"
                 ItemsSource="{Binding VisibleItems}"
                 SelectedItem="{Binding SelectedItem}"
                 SelectionMode="Multiple"
                 SelectionChanged="OnGridSelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- Virtualizing: only tiles in view are realized, so opening a folder of 50,000
                   files does not queue 50,000 thumbnail jobs. The same panel lays the filmstrip
                   out, so toggling does not throw away every realized tile. -->
              <controls:VirtualizingWrapPanel
                  ItemWidth="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ThumbnailSize}"
                  SingleRow="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Filmstrip}" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MediaItemViewModel">
             <!--
               The mark is drawn over the tile rather than behind it: the thumbnail fills its own
               border, so a pencil box underneath would be hidden by the picture it is meant to be
               drawn around. Hover marks the filename, which is where the bottom of the tile is.
             -->
             <Panel>
              <StackPanel Width="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ThumbnailSize}"
                          Margin="4" Spacing="4"
                          DoubleTapped="OnThumbnailDoubleTapped">
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open Fullscreen" Click="OnFullscreenFromMenu" />
                    <Separator />
                    <!--
                      Copy and paste together, because they are two halves of one action and having
                      them in different places was confusing. Copy takes the clicked tile's keywords;
                      paste applies to everything selected.
                    -->
                    <MenuItem Header="Keywords">
                      <MenuItem Header="Copy" Click="OnCopyKeywords" />
                      <MenuItem Header="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Batch.PasteKeywordsSummary}"
                                Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Batch.PasteKeywordsCommand}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{x:Static svc:RevealInFileManager.MenuHeader}"
                              Click="OnRevealInFileManager" />
                  </ContextMenu>
                </StackPanel.ContextMenu>
                <!--
                  The rebate: the strip of film above the frame where the edge print sits. The
                  frame's number on the sheet, and the format where film would name its stock.
                  Only under the contact sheet — it is the one part of the experiment that adds
                  height to a tile, and a tile should not pay for a look nobody asked for.
                -->
                <DockPanel Height="11" Margin="2,0"
                           IsVisible="{DynamicResource AppContactSheet}">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Stock}"
                             FontSize="9" LetterSpacing="1.2" Opacity="0.55"
                             Foreground="{DynamicResource AppEdgePrintInk}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding FrameNumber}"
                             FontSize="9" LetterSpacing="1.2" Opacity="0.85"
                             Foreground="{DynamicResource AppEdgePrintInk}"
                             VerticalAlignment="Center" />
                </DockPanel>

                <Panel Height="{Binding $parent[StackPanel].Width}">
                  <!--
                    The stack, drawn as the edge of a second card behind the first. Inset at the
                    top and left and overhanging at the bottom and right, so it reads as a sheet
                    underneath rather than as a border around — a border is what a selection is,
                    and the two must not be mistaken for each other.
                  -->
                  <Border Margin="5,5,-3,-3" CornerRadius="3"
                          Background="#10FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                          IsVisible="{Binding IsStacked}" />

                <Border Background="#18FFFFFF" CornerRadius="3">
                  <Panel>
                    <controls:LazyThumbnail Source="{Binding Thumbnail}"
                                            Stretch="Uniform"
                                            Margin="3" />
                    <TextBlock Text="No preview"
                               FontSize="11" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding ThumbnailUnavailable}" />
                    <Border Background="#99000000" CornerRadius="2"
                            Padding="4,1" Margin="4"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            IsVisible="{Binding IsVideo}">
                      <TextBlock Text="VIDEO" FontSize="9" />
                    </Border>

                    <!--
                      What is underneath. Top-left, which is the VIDEO badge's corner — and it can
                      never be wanted for both, because video does not stack.
                    -->
                    <Border Background="#99000000" CornerRadius="2"
                            Padding="4,1" Margin="4"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            IsVisible="{Binding IsStacked}"
                            ToolTip.Tip="{Binding StackTip}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <!-- Two offset sheets: the same idea as the card behind the tile. -->
                        <PathIcon Width="8" Height="8" Foreground="White" VerticalAlignment="Center"
                                  Data="M4 2h11v11h-2V4H4V2zM2 6h11v13H2V6z" />
                        <TextBlock Text="{Binding StackBadge}" FontSize="9" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="4" Spacing="2">
                      <Border Background="#CC22A0F2" CornerRadius="2" Padding="4,1"
                              ToolTip.Tip="Metadata edited but not yet written to disk"
                              IsVisible="{Binding HasPendingChanges}">
                        <TextBlock Text="● MODIFIED" FontSize="9" />
                      </Border>
                      <Border Background="#CCFF7043" CornerRadius="2" Padding="4,1"
                              ToolTip.Tip="This file and its XMP sidecar disagree"
                              IsVisible="{Binding HasConflicts}">
                        <TextBlock Text="⚠ CONFLICT" FontSize="9" />
                      </Border>
                    </StackPanel>
                    <Border Background="#99000000" CornerRadius="2"
                            Padding="4,1" Margin="4"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            ToolTip.Tip="An XMP sidecar exists for this file"
                            IsVisible="{Binding HasSidecar}">
                      <TextBlock Text="XMP" FontSize="9" />
                    </Border>

                    <!--
                      The judgements: kept or rejected, and how good. Bottom-left, on one dark
                      backing so a pale photograph cannot swallow them, and only present when there
                      is something to say — an unrated, unflagged file gets no furniture at all.
                    -->
                    <!--
                      The label. Colour and nothing else, because that is all a label is worth
                      showing at tile size and there is only ever one of them.

                      Along the bottom edge of the tile itself, inside it, rather than as a row of
                      its own between the picture and the name. As a row it added height, which
                      pushed the filename into the selection ring drawn around the tile. Here it
                      costs no layout at all, and the tile is square while photographs are not, so
                      it lands in the empty band below the picture rather than over it.
                    -->
                    <Border Height="4" CornerRadius="0,0,3,3"
                            VerticalAlignment="Bottom"
                            Background="{Binding LabelColour}"
                            IsVisible="{Binding HasLabel}"
                            ToolTip.Tip="{Binding LabelName}" />

                    <Border Background="#99000000" CornerRadius="2"
                            Padding="5,2" Margin="4"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom">
                      <Border.IsVisible>
                        <MultiBinding Converter="{StaticResource TileBadge}">
                          <Binding Path="HasRating" />
                          <Binding Path="HasFlag" />
                          <DynamicResource ResourceKey="AppVerdictInBadge" />
                        </MultiBinding>
                      </Border.IsVisible>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <!--
                          The flag glyphs step aside under the contact sheet, where the verdict
                          is written across the picture instead; the stars stay either way.
                        -->
                        <TextBlock Text="✓" FontSize="10" Foreground="White"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="Keep">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="IsAccepted" />
                              <DynamicResource ResourceKey="AppVerdictInBadge" />
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                        <TextBlock Text="✕" FontSize="10" Foreground="White"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="Rejected">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="IsRejected" />
                              <DynamicResource ResourceKey="AppVerdictInBadge" />
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                        <!--
                          Only the stars earned. Drawn rather than typed: the ★ character comes from
                          a fallback font that measures narrower than it paints, and a run of five
                          had the last one clipped away.
                        -->
                        <ItemsControl ItemsSource="{Binding RatingStars}"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding HasRating}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="1" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <PathIcon Width="8" Height="8" Foreground="White"
                                        Data="M12 2 L15 9 L22 9.5 L17 14.5 L18.5 22 L12 18 L5.5 22 L7 14.5 L2 9.5 L9 9 Z" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <!--
                      The verdict, in grease pencil, over everything: a cross through a reject, a
                      box round a keeper — the way a contact sheet was marked up before it was
                      handed back. Each is a separate mark rather than one with a switched kind,
                      so the two never share a cached geometry and a file that changes its mind
                      gets a fresh line.

                      The cross sits well inside the frame because it runs past its own bounds,
                      and should end near the corners of the picture rather than the tile.
                    -->
                    <controls:RoughMark Classes="verdict" Kind="Cross" Margin="16"
                                        IsSelected="{Binding IsRejected}" />
                    <controls:RoughMark Classes="verdict" Kind="Box" Margin="9"
                                        IsSelected="{Binding IsAccepted}" />
                  </Panel>
                </Border>
                </Panel>
                <TextBlock Text="{Binding FileName}" FontSize="11"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" />
              </StackPanel>

              <controls:RoughMark Kind="Box" Margin="1"
                                  IsSelected="{Binding $parent[ListBoxItem].IsSelected}"
                                  IsHovered="{Binding $parent[ListBoxItem].IsPointerOver}" />
             </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        </Panel>

        <GridSplitter x:Name="PreviewSplitter" Grid.Row="2" ResizeDirection="Rows"
                      Background="#22FFFFFF" DragCompleted="OnPreviewSplitterDragged" />

        <!--
          Which row each of these two sits in is the whole of "preview on top": the heights belong
          to the rows - one fills the window, the other is the size it was dragged to - and the
          panes are moved between them. Set from the code-behind, like everything else about these
          rows, because the splitter owns the heights.
        -->
        <Border x:Name="PreviewPane" Grid.Row="3" Background="{DynamicResource AppPanelBrush}">
          <Panel>

            <!-- ============ Video player ============ -->
            <!-- IsVisible lives on the wrapper: setting DataContext on the same element would make
                 compiled bindings resolve IsVisible against the player rather than this window. -->
            <Panel IsVisible="{Binding IsVideoSelected}">
            <DockPanel DataContext="{Binding Player}">

              <controls:VideoTransport x:Name="InlineTransport" DockPanel.Dock="Bottom"
                                       FullscreenRequested="OnTransportFullscreen" />

              <!-- The picture only, not the transport: double-clicking the scrub slider or a
                   transport button must not throw the window into fullscreen. A transparent
                   background so the whole area is hit-testable, including the letterbox around a
                   frame that does not fill it. -->
              <Border Background="Transparent" Margin="8"
                      DoubleTapped="OnPreviewDoubleTapped">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open Fullscreen" Click="OnFullscreen" />
                    <Separator />
                    <MenuItem Header="{x:Static svc:RevealInFileManager.MenuHeader}"
                              Click="OnRevealInFileManager" />
                  </ContextMenu>
                </Border.ContextMenu>
                <controls:VideoSurface x:Name="VideoSurface" />
              </Border>
            </DockPanel>
            </Panel>

            <!-- ============ Still preview ============ -->
            <!-- Image and loupe share this panel so they share a coordinate space: the pointer
                 position that picks the magnified spot is the same one that places the loupe. -->
            <Panel Margin="8" IsVisible="{Binding !IsVideoSelected}">

              <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform"
                     DoubleTapped="OnPreviewDoubleTapped"
                     PointerPressed="OnPreviewPointerPressed"
                     PointerMoved="OnPreviewPointerMoved"
                     PointerReleased="OnPreviewPointerReleased"
                     PointerCaptureLost="OnPreviewPointerCaptureLost">
                <Image.ContextMenu>
                  <ContextMenu>
                    <MenuItem x:Name="InspectMenuItem" Header="Inspect" Click="OnToggleInspect"
                              ToolTip.Tip="Keep the loupe open and follow the pointer. Esc to stop." />
                    <MenuItem Header="Open Fullscreen" Click="OnFullscreen" />
                    <Separator />
                    <MenuItem Header="{x:Static svc:RevealInFileManager.MenuHeader}"
                              Click="OnRevealInFileManager" />
                  </ContextMenu>
                </Image.ContextMenu>
              </Image>

              <!-- Press and hold to inspect at 1:1. Positioned by render transform, so following
                   the pointer costs no layout. -->
              <controls:Loupe x:Name="PreviewLoupe" IsVisible="False"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Source="{Binding LoupeSource}" />
            </Panel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
                    Padding="8,4" Background="#99000000" Click="OnFullscreen"
                    ToolTip.Tip="Fullscreen (F) - scroll to zoom, drag to pan">
              <PathIcon Width="13" Height="13"
                        Data="M3 3h7v2H5v5H3V3zm11 0h7v7h-2V5h-5V3zM3 14h2v5h5v2H3v-7zm16 0h2v7h-7v-2h5v-5z" />
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="!IsVideoSelected" />
                  <Binding Path="Preview" Converter="{x:Static ObjectConverters.IsNotNull}" />
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <TextBlock Text="Select an item to preview"
                       Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNull}}" />

            <!-- Only while a video is selected: unobtrusive during metadata work, obvious to anyone
                 who actually wants to watch something. -->
            <Border IsVisible="{Binding ShowFfmpegNotice}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#26FFC107" BorderBrush="#66FFC107" BorderThickness="1"
                    CornerRadius="6" Padding="20,16" MaxWidth="460">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="⚠" FontSize="16" Foreground="#FFC107" VerticalAlignment="Center" />
                  <TextBlock Text="FFmpeg is not installed" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Video thumbnails, previews and playback are unavailable until FFmpeg is installed. Metadata editing works as normal."
                           TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <TextBlock Text="{x:Static vm:MainWindowViewModel.FfmpegInstallHint}"
                           FontFamily="monospace" FontSize="12" Opacity="0.9" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="Restart BetterDAM after installing."
                           FontSize="11" Opacity="0.55" />
              </StackPanel>
            </Border>

            <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding IsPreviewLoading}" />
          </Panel>
        </Border>
      </Grid>

      <Border Grid.Column="3" Classes="grabHandle"
              IsVisible="{Binding !IsInspectorVisible}" />

      <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Classes="panel"
                    Classes.collapsed="{Binding !IsInspectorVisible}"
                    ResizeDirection="Columns"
                    DragStarted="OnPanelSplitterDragStarted"
                    DragCompleted="OnInspectorSplitterDragged"
                    ToolTip.Tip="Drag to resize the metadata panel, or click to put it away. Click again to bring it back." />

      <!-- Right panel: batch editor for a multi-selection, otherwise the single-file inspector -->
      <Panel Grid.Column="4" IsVisible="{Binding IsInspectorVisible}">

      <!-- IsVisible on the wrapper: on the same element as DataContext it would resolve against
           the batch ViewModel rather than this window. -->
      <Panel IsVisible="{Binding IsMultiSelection}">
        <views:BatchEditView DataContext="{Binding Batch}" />
      </Panel>

      <DockPanel IsVisible="{Binding !IsMultiSelection}">
        <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="#18FFFFFF"
                IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel DataContext="{Binding SelectedItem}" x:DataType="vm:MediaItemViewModel" Spacing="2">
            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} · {1} · {2}">
                  <Binding Path="File.MediaType" />
                  <Binding Path="SizeDisplay" />
                  <Binding Path="ModifiedDisplay" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock Text="{Binding File.FullPath}" FontSize="10" Opacity="0.4" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <views:MetadataInspectorView DataContext="{Binding Inspector}" />
      </DockPanel>
      </Panel>

    </Grid>
  </DockPanel>
</Window>
